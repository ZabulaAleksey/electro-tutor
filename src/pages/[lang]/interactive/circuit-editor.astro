---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CircuitEditor from "../../../circuit/CircuitEditor";
import { circuitCopy } from "../../../circuit/copy";
import { getLocale } from "../../../i18n";
import type { Language } from "../../../types";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}
const language = Astro.params.lang as Language;
const copy = circuitCopy(language);
---
<BaseLayout title={`${copy.title} · ${getLocale(language).brand.display}`} description={copy.description}
  language={language} active="interactive" alternatePath="/interactive/circuit-editor/">
  <CircuitEditor client:load language={language} />
</BaseLayout>

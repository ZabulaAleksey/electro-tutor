---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LegacyCircularRoute from "../../components/LegacyCircularRoute";
import "../../components/CircularDiagram.css";
import "../../components/CircularDiagramMath.css";
import type { Language } from "../../types";
import { getLocale } from "../../i18n";
import "../../components/StarNeutralLab.css";
import "../../components/TransmissionLineLab.css";
import ResourceCatalogue from "../../components/ResourceCatalogue.astro";
import { getContentCatalogue } from "../../learning/get-content-catalogue";
import { contentCopy } from "../../learning/navigation-copy";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}
const language = Astro.params.lang as Language;
const copy = getLocale(language);
const title = contentCopy[language].labs;
const { resources } = await getContentCatalogue(language);
---

<BaseLayout
  title={`${title} — ElectroTutor`}
  description={copy.interactive.description}
  language={language}
  active="interactive"
  alternatePath="/interactive/"
>
  <ResourceCatalogue id="labs" {title} {language} resources={resources.filter(resource => resource.kind === "labs")} pageHeading />
  <LegacyCircularRoute client:load {language} />
</BaseLayout>

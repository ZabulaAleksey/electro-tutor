---
import { render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import MeshLessonIsland from "../../../../components/MeshLessonIsland";
import { resolveInteractiveComponent } from "../../../../content/interactive-registry";
import { getPublishedLessonManifest } from "../../../../content/published-lessons";
import type { Language } from "../../../../types";
import { getLocale } from "../../../../i18n";

export async function getStaticPaths() {
  const lessons = await getPublishedLessonManifest();
  return lessons.map((lesson) => ({
    params: {
      lang: lesson.language,
      section: lesson.section,
      slug: lesson.slug,
    },
    props: { entry: lesson.entry },
  }));
}

const { entry } = Astro.props;
const language = entry.data.language as Language;
const copy = getLocale(language);
const { Content } = await render(entry);
const alternatePath = `/topics/${entry.data.section}/${entry.data.slug}/`;
const registeredInteractive = resolveInteractiveComponent(entry.data.interactive);
// Astro's hydration transform must see the concrete component import in this module.
const hasMeshInteractive = registeredInteractive === MeshLessonIsland;
---

<BaseLayout
  title={`${entry.data.title} — ${copy.lesson.brandSeparator}`}
  description={entry.data.description}
  language={language}
  active="topics"
  alternatePath={alternatePath}
  keywords={entry.data.keywords}
>
  <article class="lesson-intro">
    {!registeredInteractive ? <h1>{entry.data.title}</h1> : null}
    <Content />
  </article>
  {hasMeshInteractive ? <MeshLessonIsland language={language} client:load /> : null}
</BaseLayout>

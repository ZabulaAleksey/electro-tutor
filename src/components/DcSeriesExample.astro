---
interface Props {
  language: "ru" | "uk";
  voltage: number;
  firstResistance: number;
  secondResistance: number;
}

const { language, voltage, firstResistance, secondResistance } = Astro.props;
const names = language === "ru" ? {
  title: "Два резистора последовательно",
  description: "Ток идёт от положительного вывода источника вправо через два резистора и возвращается по нижнему проводу к отрицательному выводу.",
} : {
  title: "Два резистори послідовно",
  description: "Струм іде від додатного виводу джерела праворуч через два резистори й повертається нижнім проводом до від’ємного виводу.",
};
const number = new Intl.NumberFormat(language === "ru" ? "ru-RU" : "uk-UA", { maximumFractionDigits: 6 });
const prefix = "home-dc-" + language;
const id = (name: string) => prefix + "-" + name;
const paint = (name: string) => "url(#" + id(name) + ")";
const resistors = [
  { x: 216, label: "R₁ = " + number.format(firstResistance) + " Ω", palette: "amber" },
  { x: 346, label: "R₂ = " + number.format(secondResistance) + " Ω", palette: "violet" },
];
---
<svg class="dc-figure" viewBox="0 0 520 312" width="520" height="312"
  role="img" aria-labelledby={id("title")} aria-describedby={id("description")}>
  <title id={id("title")}>{names.title}</title>
  <desc id={id("description")}>{names.description}</desc>
  <defs>
    <radialGradient id={id("background")} cx=".38" cy=".32" r=".74">
      <stop stop-color="#223854" />
      <stop offset="1" stop-color="#101b30" />
    </radialGradient>
    <linearGradient id={id("wire")} x2="0" y2="1">
      <stop stop-color="#effcff" />
      <stop offset=".34" stop-color="#99e6fb" />
      <stop offset="1" stop-color="#42718e" />
    </linearGradient>
    <linearGradient id={id("battery")} x2="1" y2="0">
      <stop stop-color="#b0574d" />
      <stop offset=".27" stop-color="#fba16f" />
      <stop offset=".55" stop-color="#ffcb9b" />
      <stop offset="1" stop-color="#813d48" />
    </linearGradient>
    <linearGradient id={id("amber")} x2="0" y2="1">
      <stop stop-color="#ffbf87" />
      <stop offset=".5" stop-color="#d68060" />
      <stop offset="1" stop-color="#b85a59" />
    </linearGradient>
    <linearGradient id={id("violet")} x2="0" y2="1">
      <stop stop-color="#e0c5ff" />
      <stop offset=".48" stop-color="#ac90e7" />
      <stop offset="1" stop-color="#7259ae" />
    </linearGradient>
    <pattern id={id("grid")} width="24" height="24" patternUnits="userSpaceOnUse">
      <path d="M24 0H0V24" fill="none" stroke="#afc4e9" opacity=".12" />
    </pattern>
    <marker id={id("arrow")} markerWidth="10" markerHeight="10" refX="8.5" refY="5" orient="auto" markerUnits="userSpaceOnUse">
      <path d="M0 0 10 5 0 10 3 5Z" fill="#76e6ff" />
    </marker>
  </defs>

  <rect width="520" height="312" rx="20" fill={paint("background")} />
  <rect x="20" y="19" width="480" height="274" rx="13" fill={paint("grid")} />
  <g fill="none" stroke-linejoin="round" stroke-linecap="round">
    <path d="M114 137V119Q114 108 126 108H216M299 108H346M429 108H459Q471 108 471 120V226Q471 238 459 238H125Q114 238 114 227V210"
      stroke="#091426" stroke-width="13" transform="translate(0 4)" />
    <path d="M114 137V119Q114 108 126 108H216M299 108H346M429 108H459Q471 108 471 120V226Q471 238 459 238H125Q114 238 114 227V210"
      stroke={paint("wire")} stroke-width="8" />
  </g>
  <g>
    <ellipse cx="115" cy="210" rx="37" ry="10" fill="#091426" opacity=".7" />
    <path d="M83 148V202C83 213 145 213 145 202V148Z" fill={paint("battery")} />
    <ellipse cx="114" cy="148" rx="31" ry="11" fill="#ffd1a5" />
    <path d="M104 136V145C104 149 124 149 124 145V136Z" fill="#dc896a" />
    <ellipse cx="114" cy="136" rx="10" ry="4" fill="#ffdebd" />
    <path d="M84 195C98 203 130 203 144 195" fill="none" stroke="#7d3b46" stroke-width="2" opacity=".74" />
    <g fill="none" stroke="#3b243a" stroke-width="3" stroke-linecap="round" aria-hidden="true">
      <path d="M108 164H120M114 158V170" />
      <path d="M108 187H120" />
    </g>
    <text x="114" y="276" class="nominal" text-anchor="middle">{"E = " + number.format(voltage) + " В"}</text>
  </g>

  {resistors.map((item) => (
    <g transform={"translate(" + item.x + " 0)"} data-demo-resistor>
      <path d="M-5 108H9M73 108H89" stroke={paint("wire")} stroke-width="8" stroke-linecap="round" />
      <path d="M4 101H74L86 93V118L74 125H4Z" fill="#192944" stroke="#132037" stroke-width="2" transform="translate(0 5)" />
      <path d="M4 99H74V123H4Z" fill={paint(item.palette)} />
      <path d="M4 99 16 91H86L74 99Z" fill={item.palette === "amber" ? "#ffe0b5" : "#e8daff"} />
      <path d="M74 99 86 91V115L74 123Z" fill={item.palette === "amber" ? "#aa6258" : "#735ba7"} />
      <path d="M14 105H64M14 116H64" fill="none" stroke="#ffffff" stroke-opacity=".35" stroke-linecap="round" />
      <text x="45" y="72" class="nominal" text-anchor="middle">{item.label}</text>
    </g>
  ))}

  <g font-size="15" font-weight="650" text-anchor="middle" fill="#e0f0ff">
    <text x="162" y="94">A</text>
    <text x="323" y="94">B</text>
    <text x="156" y="226">0</text>
  </g>
  <g fill="none" stroke="#76e6ff" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
    <line data-demo-flow x1="178" y1="147" x2="440" y2="147" marker-end={paint("arrow")} />
    <line data-demo-flow x1="440" y1="205" x2="178" y2="205" marker-end={paint("arrow")} />
  </g>
  <g font-size="17" font-style="italic" font-weight="650" text-anchor="middle" fill="#a6edff" aria-hidden="true">
    <text x="310" y="169">I</text>
    <text x="310" y="194">I</text>
  </g>
</svg>
<style>
  .dc-figure { display: block; width: 100%; height: auto; }
  .nominal { fill: #f1f6ff; font: 650 18px system-ui, sans-serif; }
</style>

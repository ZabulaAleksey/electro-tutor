---
import EditorialHome from "../../components/EditorialHome.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localePath } from "../../site-path";
import { stories } from "../../showcase/catalog";
import { microLabs } from "../../showcase/micro-catalog";

export function getStaticPaths() {
  return [{ params: { lang: "ru" as const } }, { params: { lang: "uk" as const } }];
}

const { lang: language } = Astro.params;
const title = language === "ru" ? "Электротехника на практике" : "Електротехніка на практиці";
const description = language === "ru" ? "Интерактивные лаборатории и доска ElectroTutor." : "Інтерактивні лабораторії та дошка ElectroTutor.";
const legacy = {
  "#learning-contents": localePath(language, "/topics/"),
  "#labs": localePath(language, "/interactive/"),
  "#tools": localePath(language, "/tools/"),
  ...Object.fromEntries(stories.map(({ id }) => [`#story=${id}`, localePath(language, `/showcase/#story=${id}`)])),
  ...Object.fromEntries(microLabs.map(({ id }) => [`#micro=${id}`, localePath(language, `/micro-labs/#micro=${id}`)])),
};
---
<BaseLayout title={`${title} — ElectroTutor`} {description} {language} active="home" alternatePath="/">
  <EditorialHome {language} />
  <script is:inline data-astro-rerun define:vars={{ legacy }}>
    const redirectBookmark = () => {
      const target = Object.hasOwn(legacy, location.hash) && legacy[location.hash];
      if (target) {
        const url = new URL(target, location.origin);
        url.search = location.search;
        location.replace(url);
      }
    };
    redirectBookmark();
    addEventListener("hashchange", redirectBookmark);
    document.addEventListener("astro:before-swap", () => removeEventListener("hashchange", redirectBookmark), { once: true });
  </script>
</BaseLayout>

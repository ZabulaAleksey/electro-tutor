{
    "name": "electro-tutor",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@11.23.0",
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "pnpm run check:locales && astro build && node scripts/audit-built-locales.mjs && node scripts/audit-built-lessons.mjs && node scripts/audit-built-site.mjs",
        "check:base-path": "node scripts/check-base-path.mjs",
        "preview": "astro preview",
        "lint": "eslint .",
        "check": "astro check",
        "check:context": "node scripts/validate-context-route.mjs",
        "check:ci-workflow": "node scripts/ci-workflow-contract.mjs",
        "check:hygiene": "node scripts/check-git-hygiene.mjs",
        "check:locales": "node scripts/validate-locales.mjs",
        "test": "vitest run",
        "test:e2e": "pnpm run build && node scripts/run-e2e.mjs",
        "test:e2e:built": "node scripts/run-e2e.mjs",
        "test:e2e:production-smoke": "node scripts/run-production-e2e-smoke.mjs",
        "test:e2e:root": "node scripts/check-root-e2e.mjs",
        "test:e2e:install": "playwright install chromium",
        "verify:full": "node scripts/full-verify.mjs"
    },
    "dependencies": {
        "@astrojs/mdx": "^7.0.3",
        "@astrojs/react": "^6.0.1",
        "@astrojs/sitemap": "^3.7.3",
        "astro": "^7.1.3",
        "katex": "^0.16.11",
        "lucide-react": "^0.468.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@eslint/js": "^9.17.0",
        "@playwright/test": "^1.62.1",
        "@types/react": "^19.0.3",
        "@types/react-dom": "^19.0.2",
        "@vitejs/plugin-react": "^5.2.0",
        "dependency-cruiser": "^18.1.0",
        "eslint": "^9.17.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^15.14.0",
        "madge": "^8.0.0",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.18.2",
        "vite": "8.2.1",
        "vitest": "^4.1.10",
        "yaml": "^2.9.0"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "optionalDependencies": {
        "@astrojs/compiler-binding-linux-x64-gnu": "^0.3.1",
        "@bruits/satteri-linux-x64-gnu": "^0.9.5",
        "@rolldown/binding-linux-x64-gnu": "^1.1.5",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    }
}

---
import LaboratoryPage from "../../../components/LaboratoryPage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RollingLab from "../../../components/RollingLab";
import type { Language } from "../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const ru = language === "ru";
const title = ru ? "Качение тела по заданному следу" : "Кочення тіла за заданим слідом";
const description = ru
  ? "Рассчитайте форму тела по следу точки контакта и проследите его качение на плоскости."
  : "Розрахуйте форму тіла за слідом точки контакту й простежте його кочення на площині.";
---
<BaseLayout {title} {description} {language} active="interactive" alternatePath="/interactive/rolling/">
  <LaboratoryPage {language} title={title} description={description}>
    <RollingLab client:load {language} />
  </LaboratoryPage>
</BaseLayout>

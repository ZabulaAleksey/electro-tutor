---
const target=import.meta.env.BASE_URL+"ru/";
const canonical=new URL(target,Astro.site);
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta http-equiv="refresh" content={`0;url=${target}`}/><meta name="robots" content="noindex,follow"/><link rel="canonical" href={canonical}/><title>ElectroTutor</title></head><body><p>Открываем ElectroTutor.</p><a href={target}>Перейти на главную</a></body></html>

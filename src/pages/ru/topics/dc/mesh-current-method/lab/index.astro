---
import BaseLayout from "../../../../../../layouts/BaseLayout.astro";
import LaboratoryPage from "../../../../../../components/LaboratoryPage.astro";
import { copy } from "../../../../../../mesh/ru";
import MeshLab from "../../../../../../mesh/MeshLab";
import MeshJourney from "../../../../../../mvp/MeshJourney.astro";
---
<BaseLayout title="Лаборатория контурных токов — ElectroTutor" description="Четыре интерактивные схемы: меняйте сопротивления, ЭДС и ток источника, наблюдайте контурные и ветвевые токи, напряжения и баланс мощности." language="ru" active="interactive" alternatePath="/topics/dc/mesh-current-method/lab/" hasTranslation={false}>
  <LaboratoryPage language="ru" title={copy.title} description={copy.staticHint}>
    <MeshJourney stage={2} animated={false}><MeshLab showIntro={false} persistContext={true} ownerPath={Astro.url.pathname} client:load /></MeshJourney>
  </LaboratoryPage>
</BaseLayout>

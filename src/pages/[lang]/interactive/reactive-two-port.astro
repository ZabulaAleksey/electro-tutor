---
import CompatibilityRedirect from "../../../components/CompatibilityRedirect.astro";
import type { Language } from "../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const ru = language === "ru";
const title = ru ? "LC-двухполюсник" : "LC-двополюсник";
const description = ru ? "Исследование входного импеданса LC-цепи." : "Дослідження вхідного імпедансу LC-кола.";
---
<CompatibilityRedirect language={language} destinationPath="/interactive/reactive-two-port-graph/experiment/" alternatePath="/interactive/reactive-two-port/" title={title} description={description} />

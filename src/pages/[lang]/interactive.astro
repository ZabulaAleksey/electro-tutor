---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CircularDiagram from "../../components/CircularDiagram";
import "../../components/CircularDiagram.css";
import "../../components/CircularDiagramMath.css";
import type { Language } from "../../types";
import { getLocale } from "../../i18n";
import { localePath } from "../../site-path";
import "../../components/StarNeutralLab.css";
import "../../components/TransmissionLineLab.css";
import { lineCopy } from "../../transient/copy";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}
const language = Astro.params.lang as Language;
const copy = getLocale(language);
const line = lineCopy(language);
---

<BaseLayout
  title={copy.interactive.title}
  description={copy.interactive.description}
  language={language}
  active="interactive"
  alternatePath="/interactive/"
>
  <section class="section info-page interactive-intro">
    <span class="eyebrow"><i></i>{copy.interactive.eyebrow}</span>
    <h1>{copy.interactive.heading}</h1>
    <p>{copy.interactive.lead}</p>
  </section>
  <div class="section interactive-section">
    <div class="interactive-links">
    <article class="star-entry"><span class="section-kicker">{copy.star.kicker}</span>
      <h2>{copy.star.title}</h2><p>{copy.star.cardLead}</p>
      <a href={localePath(language, "/interactive/star-neutral/")}>{copy.star.open} →</a>
    </article>
    <article><span class="section-kicker">{copy.diagram.kicker}</span><h2>{copy.diagram.title}</h2>
      <p>{line.circularCard}</p><a href={localePath(language, "/interactive/circular-diagram/")}>{line.circularOpen} →</a></article>
    <article><span class="section-kicker">{line.line}</span><h2>{line.title}</h2>
      <p>{line.card}</p><a href={localePath(language, "/interactive/transmission-line/")}>{line.open} →</a></article>
    </div>
    <CircularDiagram client:load transition:persist="circular-diagram" language={language} />
  </div>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Classroom from "../../components/Classroom";
import type { Language } from "../../types";
import { getLocale } from "../../i18n";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}

const language = Astro.params.lang as Language;
const copy = getLocale(language);
---
<BaseLayout
  title={copy.classroomPage.title}
  description={copy.classroomPage.description}
  language={language}
  active="classroom"
  alternatePath="/classroom/"
>
  <Classroom language={language} client:load />
</BaseLayout>

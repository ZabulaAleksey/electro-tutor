---
import ContentHome from "../../components/ContentHome.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EngineeringShowcase from "../../showcase/EngineeringShowcase";
import type { Language } from "../../types";
import { getLocale } from "../../i18n";
import { publicSurface } from "../../public-surface";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}

const language = Astro.params.lang as Language;
const copy = getLocale(language);
---

<BaseLayout
  title={copy.home.title}
  description={copy.home.description}
  language={language}
  active="home"
  alternatePath="/"
>
  <ContentHome {language} />
  <EngineeringShowcase client:load {language} />

  {publicSurface.showProgress && <section class="section" aria-labelledby="learning-summary-title">
    <div class="learning-summary">
      <h2 id="learning-summary-title">{copy.learning.summaryDevice}</h2>
      <div data-learning-summary></div>
    </div>
  </section>}

</BaseLayout>

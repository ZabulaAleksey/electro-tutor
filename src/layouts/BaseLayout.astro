---
import "katex/dist/katex.min.css";
import "../styles.css";
import "../pwa.css";
import type { Language } from "../types";
import { getLocale, getOtherLanguage } from "../i18n";
import { localePath, SITE_BASE_PATH, withBasePath } from "../site-path";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string; description: string; language: Language;
  active?: "home" | "topics" | "interactive" | "classroom" | "services" | "contacts";
  alternatePath?: string; keywords?: string[];
}
const { title, description, language, active = "home", alternatePath = "/", keywords = [] } = Astro.props;
const copy = getLocale(language);
const otherLanguage = getOtherLanguage(language);
const canonical = new URL(localePath(language, alternatePath), Astro.site);
const alternate = new URL(localePath(otherLanguage, alternatePath), Astro.site);
const defaultAlternate = new URL(localePath("ru", alternatePath), Astro.site);
const manifestPath = withBasePath("/manifest.webmanifest");
const iconPath = withBasePath("/icons/potential.svg");
const webFontScriptPath = withBasePath("/scripts/web-font.js");
const serviceWorkerPath = withBasePath("/sw.js");
const webFontStylesheet = "https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap";
const nav = [
  { id: "home", href: localePath(language), label: copy.nav.home },
  { id: "topics", href: localePath(language, "/topics/"), label: copy.nav.topics },
  { id: "interactive", href: localePath(language, "/interactive/"), label: copy.nav.interactive },
  { id: "classroom", href: localePath(language, "/classroom/"), label: copy.nav.classroom },
  { id: "services", href: localePath(language, "/services/"), label: copy.nav.services },
  { id: "contacts", href: localePath(language, "/contacts/"), label: copy.nav.contacts },
];
---
<!doctype html>
<html lang={language} data-base-path={SITE_BASE_PATH} data-service-worker-path={serviceWorkerPath}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#246b54" />
  <meta name="description" content={description} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content={copy.brand.name} />
  {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
  <link rel="manifest" href={manifestPath} />
  <link rel="icon" href={iconPath} type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={otherLanguage} href={alternate} />
  <link rel="alternate" hreflang={language} href={canonical} />
  <link rel="alternate" hreflang="x-default" href={defaultAlternate} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href={webFontStylesheet} />
  <link rel="stylesheet" href={webFontStylesheet} media="print" data-web-font-stylesheet />
  <script is:inline src={webFontScriptPath} defer></script>
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <title>{title}</title>
  <ClientRouter />
  <script is:inline>
    (() => {
      const saved = localStorage.getItem("potential-theme");
      document.documentElement.dataset.theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    })();
  </script>
</head>
<body>
  <header class="header astro-header">
    <a class="brand" href={localePath(language)} aria-label={copy.brand.name}>
      <span class="brand-mark" aria-hidden="true">∿</span>
      <span><strong>{copy.brand.display}</strong><small>{copy.brand.tagline}</small></span>
    </a>
    <nav aria-label={copy.nav.label}>
      {nav.map(item => <a class:list={{ active: active === item.id }} href={item.href}>{item.label}</a>)}
    </nav>
    <button class="mobile-menu-toggle" id="mobile-menu-toggle" type="button" aria-expanded="false" aria-label={copy.actions.openMenu}>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
    <button class="app-install-link" id="app-install" type="button" aria-label={copy.actions.install}>
      <span class="app-install-icon" aria-hidden="true">⇩</span><span class="app-install-label">{copy.actions.application}</span>
    </button>
    <button class="theme-toggle" id="theme-toggle" aria-label={copy.actions.theme} title={copy.actions.themeTitle}>
      <span class="theme-light">☾</span><span class="theme-dark">☀</span>
    </button>
    <a class="language-link" data-language-link href={localePath(otherLanguage, alternatePath)}>{language === "ru" ? "UA" : "RU"}</a>
  </header>
  <main><slot /></main>
  <footer><span>© 2026 {copy.brand.name}</span><span>{copy.brand.motto}</span></footer>

  <dialog class="install-dialog" id="install-dialog">
    <div class="install-dialog-content">
      <h2>{copy.install.title}</h2>
      <p>{copy.install.description}</p>
      <ol data-ios-steps hidden>
        <li>{copy.install.stepShare}</li>
        <li>{copy.install.stepHome}</li>
        <li>{copy.install.stepAdd}</li>
      </ol>
      <form method="dialog"><button class="button primary">{copy.actions.understood}</button></form>
    </div>
  </dialog>

  <script is:inline>
    (() => {
      const state = window.__potentialUi ||= { installPrompt: null, globalEventsReady: false };

      const applySavedTheme = () => {
        const saved = localStorage.getItem("potential-theme");
        document.documentElement.dataset.theme = saved
          || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      };

      const closeMobileMenu = () => {
        const header = document.querySelector(".astro-header");
        const toggle = document.querySelector("#mobile-menu-toggle");
        header?.classList.remove("mobile-open");
        toggle?.setAttribute("aria-expanded", "false");
      };

      const restoreLanguageScroll = () => {
        const saved = sessionStorage.getItem("potential-language-scroll");
        if (!saved) return;
        sessionStorage.removeItem("potential-language-scroll");
        try {
          const scroll = JSON.parse(saved);
          if (scroll.path === location.pathname && Number.isFinite(scroll.y)) {
            requestAnimationFrame(() => requestAnimationFrame(() => scrollTo(0, scroll.y)));
          }
        } catch {}
      };

      const initializePageControls = () => {
        applySavedTheme();
        const header = document.querySelector(".astro-header");
        const menuToggle = document.querySelector("#mobile-menu-toggle");
        const themeToggle = document.querySelector("#theme-toggle");
        const installButton = document.querySelector("#app-install");
        const installDialog = document.querySelector("#install-dialog");
        const iosSteps = installDialog?.querySelector("[data-ios-steps]");
        const standalone = matchMedia("(display-mode: standalone)").matches || navigator.standalone === true;
        const ios = /iphone|ipad|ipod/i.test(navigator.userAgent);

        if (menuToggle) menuToggle.onclick = () => {
          const open = header?.classList.toggle("mobile-open") ?? false;
          menuToggle.setAttribute("aria-expanded", String(open));
        };
        header?.querySelectorAll("nav a").forEach(link => link.onclick = closeMobileMenu);

        if (themeToggle) themeToggle.onclick = () => {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          localStorage.setItem("potential-theme", next);
        };

        if (standalone) installButton?.setAttribute("hidden", "");
        if (installButton) installButton.onclick = async () => {
          if (state.installPrompt) {
            await state.installPrompt.prompt();
            const result = await state.installPrompt.userChoice;
            if (result.outcome === "accepted") installButton.setAttribute("hidden", "");
            state.installPrompt = null;
            return;
          }
          if (iosSteps) iosSteps.hidden = !ios;
          installDialog?.showModal();
        };

        restoreLanguageScroll();
      };

      if (!state.globalEventsReady) {
        state.globalEventsReady = true;
        document.addEventListener("click", event => {
          const origin = event.target;
          const link = origin instanceof Element ? origin.closest("[data-language-link]") : null;
          if (!(link instanceof HTMLAnchorElement)) return;
          const target = new URL(link.href);
          target.search = location.search;
          target.hash = location.hash;
          link.href = target.toString();
          sessionStorage.setItem("potential-language-scroll", JSON.stringify({ path: target.pathname, y: scrollY }));
        }, true);
        addEventListener("keydown", event => {
          if (event.key === "Escape") closeMobileMenu();
        });
        addEventListener("beforeinstallprompt", event => {
          event.preventDefault();
          state.installPrompt = event;
        });
        addEventListener("appinstalled", () => {
          document.querySelector("#app-install")?.setAttribute("hidden", "");
        });
        document.addEventListener("astro:page-load", initializePageControls);
        if ("serviceWorker" in navigator) {
          addEventListener("load", () => {
            const root = document.documentElement;
            const scriptURL = root.dataset.serviceWorkerPath;
            const scope = root.dataset.basePath;
            if (scriptURL && scope) navigator.serviceWorker.register(scriptURL, { scope });
          }, { once: true });
        }
      }

      initializePageControls();
    })();
  </script>
</body>
</html>

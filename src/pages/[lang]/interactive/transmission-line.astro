---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TransmissionLineLab from "../../../components/TransmissionLineLab";
import "../../../components/TransmissionLineLab.css";
import { lineCopy } from "../../../transient/copy";
import { getLocale } from "../../../i18n";
import { localePath } from "../../../site-path";
import type { Language } from "../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const copy = lineCopy(language);
---
<BaseLayout title={`${copy.title} — ${getLocale(language).brand.name}`} description={copy.description}
  language={language} active="interactive" alternatePath="/interactive/transmission-line/">
  <section class="line-page">
    <div class="line-page-intro"><a href={localePath(language, "/interactive/")}>← {copy.back}</a>
      <h1>{copy.title}</h1><p>{copy.lead}</p></div>
    <TransmissionLineLab client:load language={language} />
  </section>
</BaseLayout>

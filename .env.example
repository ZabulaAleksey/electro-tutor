# Exact public production URL. Used for canonical URLs and sitemap.
SITE_URL=https://your-domain.example

# Deployment path. Keep / for a root domain; use /repository-name/ for a project site.
BASE_PATH=/

# Public Cal.com booking page, for example:
# PUBLIC_CALCOM_URL=https://cal.com/your-name/electrical-engineering
PUBLIC_CALCOM_URL=

# ET-09.2 backend configuration names are listed as a reference only. The
# supported root/Compose path owns fixed safe local values and does not load
# these entries as overrides. They are local placeholders, not credentials.
ET_ENVIRONMENT=local
ET_HOST=127.0.0.1
ET_PORT=8000
ET_DOCS_ENABLED=true
ET_DATABASE_URL=postgresql+asyncpg://electro_tutor_runtime:local-runtime-only@127.0.0.1:55432/electro_tutor
ET_MIGRATION_DATABASE_URL=postgresql+asyncpg://electro_tutor_migrator:local-migration-only@127.0.0.1:55432/electro_tutor

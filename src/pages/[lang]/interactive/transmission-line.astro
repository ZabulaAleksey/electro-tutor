---
import LaboratoryPage from "../../../components/LaboratoryPage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TransmissionNetworkLab from "../../../components/TransmissionNetworkLab";
import "../../../components/TransmissionNetworkLab.css";
import { lineCopy } from "../../../transient/copy";
import { getLocale } from "../../../i18n";
import { localePath } from "../../../site-path";
import type { Language } from "../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const copy = lineCopy(language);
---
<BaseLayout title={`${copy.title} — ${getLocale(language).brand.display}`} description={copy.description}
  language={language} active="interactive" alternatePath="/interactive/transmission-line/">
  <LaboratoryPage {language} title={copy.title} description={copy.lead}>
    <div class="line-actions">
      <a data-astro-reload href={localePath(language, "/interactive/transmission-line-steady/experiment/")}>{language === "ru" ? "Синусоидальный режим" : "Синусоїдний режим"}</a>
      <a href="#network-results">{language === "ru" ? "Управление опытом" : "Керування дослідом"}</a>
    </div>
    <TransmissionNetworkLab client:load language={language} />
  </LaboratoryPage>
</BaseLayout>

<style>
  .line-actions { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-bottom: 1rem; }
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CircularDiagram from "../../components/CircularDiagram";
import "../../components/CircularDiagram.css";
import "../../components/CircularDiagramMath.css";
import type { Language } from "../../types";
import { getLocale } from "../../i18n";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}
const language = Astro.params.lang as Language;
const copy = getLocale(language);
---

<BaseLayout
  title={copy.interactive.title}
  description={copy.interactive.description}
  language={language}
  active="interactive"
  alternatePath="/interactive/"
>
  <section class="section info-page interactive-intro">
    <span class="eyebrow"><i></i>{copy.interactive.eyebrow}</span>
    <h1>{copy.interactive.heading}</h1>
    <p>{copy.interactive.lead}</p>
  </section>
  <div class="section interactive-section">
    <CircularDiagram client:load transition:persist="circular-diagram" language={language} />
  </div>
</BaseLayout>

---
import type { Language } from '../types';
interface Props { language: Language; textbook: string; examples: string; lab: string; }
const {language,textbook,examples,lab}=Astro.props;
const ru=language==='ru';
const t=(r:string,u:string)=>ru?r:u;
const stages=[
 {icon:'▤',title:t('Учебник','Підручник'),description:t('Подробная теория, выводы формул, наглядные иллюстрации и объяснения без пропущенных шагов.','Докладна теорія, виведення формул, наочні ілюстрації та пояснення без пропущених кроків.'),action:t('Перейти к теории','Перейти до теорії'),href:textbook},
 {icon:'∑',title:t('Примеры','Приклади'),description:t('Разбор цепей с исходными данными, системой уравнений, вычислениями и проверкой ответов.','Розбір кіл із вихідними даними, системою рівнянь, обчисленнями та перевіркою відповідей.'),action:t('Смотреть решение','Переглянути розв’язання'),href:examples},
 {icon:'ϟ',title:t('Лаборатория','Лабораторія'),description:t('Меняйте параметры источников и резисторов. Исследуйте токи, напряжения и баланс мощностей.','Змінюйте параметри джерел і резисторів. Досліджуйте струми, напруги та баланс потужностей.'),action:t('Запустить эксперимент','Почати експеримент'),href:lab},
];
---
<div class="reference-home">
 <section class="ref-hero"><div class="ref-page ref-hero-grid">
  <div><span class="ref-eyebrow">ϟ {t('Теория. Практика. Эксперимент.','Теорія. Практика. Експеримент.')}</span>
   <h1>{t('Электротехника,','Електротехніка,')}<br/>{t('которую можно','яку можна')} <span>{t('увидеть.','побачити.')}</span></h1>
   <p class="ref-sub">{t('Изучайте законы электрических цепей, разбирайте решения шаг за шагом и экспериментируйте с настоящими расчётами — прямо в браузере.','Вивчайте закони електричних кіл, розбирайте розв’язання крок за кроком та експериментуйте зі справжніми розрахунками — просто в браузері.')}</p>
   <div class="ref-ctas"><a class="ref-button ref-primary mvp-start" href={textbook}>{t('Открыть учебник','Відкрити підручник')} ↗</a><a class="ref-button" href={lab}>{t('Попробовать лабораторию','Спробувати лабораторію')} →</a></div>
   <div class="ref-benefits">{[t('Понятные объяснения','Зрозумілі пояснення'),t('Живые схемы','Живі схеми'),t('Без установки','Без встановлення')].map(label=><span><b>✓</b> {label}</span>)}</div>
  </div>
  <div class="ref-demo"><div class="ref-demo-top"><i></i><i></i><i></i><span>{t('Электрическая цепь · закон Ома','Електричне коло · закон Ома')}</span></div><div class="ref-circuit">
<svg viewBox="0 0 520 280" role="img" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label={t("Электрическая схема с источником и резисторами","Електрична схема з джерелом і резисторами")}><path d="M80 62H410V216H80V62" stroke="#394472" stroke-width="3.5" stroke-linejoin="round"/><path d="M80 139V157" stroke="#fcfdff" stroke-width="10"/><path d="M64 139H96M71 157H89" stroke="#6553ef" stroke-width="3.5"/><path d="M215 62H279" stroke="#fcfdff" stroke-width="12"/><path d="M215 62l9 -12 11 24 11 -24 11 24 11 -24 11 12" stroke="#6553ef" stroke-width="3.5"/><path d="M410 112V172" stroke="#fcfdff" stroke-width="12"/><path d="M410 112l-12 10 24 10 -24 10 24 10 -24 10 12 10" stroke="#2bafc0" stroke-width="3.5"/><circle cx="80" cy="62" r="5" fill="#6553ef"/><circle cx="410" cy="62" r="5" fill="#6553ef"/><circle cx="410" cy="216" r="5" fill="#6553ef"/><circle cx="80" cy="216" r="5" fill="#6553ef"/><path d="M125 39h52m-11 -8 11 8 -11 8" stroke="#1faeaa" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><text x="125" y="25" font-size="15" fill="#169b9d" font-weight="700">I = 2 А</text><text x="55" y="152" font-size="15" fill="#5f4be5" font-weight="700" text-anchor="end">12 В</text><text x="246" y="33" font-size="14" fill="#5f4be5" text-anchor="middle">R₁ = 2 Ω</text><text x="435" y="144" font-size="14" fill="#169b9d">R₂ = 4 Ω</text><text x="250" y="147" font-size="29" fill="#313c75" font-family="Georgia,serif" text-anchor="middle">I = U / R</text><text x="250" y="173" font-size="13" fill="#7d88a0" text-anchor="middle">{t("Закон Ωа","Закон Ωа")}</text></svg>
  </div><div class="ref-metrics"><div><small>{t('Напряжение','Напруга')}</small><strong>12 В</strong></div><div><small>{t('Сопротивление','Опір')}</small><strong>6 {t('Ом','Ом')}</strong></div><div><small>{t('Сила тока','Сила струму')}</small><strong>2 А</strong></div></div></div>
 </div></section>
 <section class="ref-page ref-path"><div class="ref-kicker">{t('Один маршрут от теории до практики','Один маршрут від теорії до практики')}</div><h2>{t('Понимать. Решать. Проверять.','Розуміти. Розв’язувати. Перевіряти.')}</h2><p class="ref-intro">{t('Начните с объяснения, разберите пример и сразу проверьте выводы на интерактивной схеме.','Почніть із пояснення, розберіть приклад та одразу перевірте висновки на інтерактивній схемі.')}</p>
  <div class="ref-cards">{stages.map((s,i)=><article class="ref-card"><div class="ref-icon" aria-hidden="true">{s.icon}</div><h3>0{i+1}. {s.title}</h3><p>{s.description}</p><a href={s.href}>{s.action} ↗</a></article>)}</div>
 </section>
 <section class="ref-workspace"><div class="ref-page ref-workspace-grid"><aside class="ref-sidebar" aria-label={t('Разделы обучения','Розділи навчання')}><p>{t('Разделы обучения','Розділи навчання')}</p>{stages.map((s,i)=><a href={s.href}><span aria-hidden="true">{s.icon}</span>{s.title}<small>0{i+1}</small></a>)}</aside>
  <div><div class="ref-work-heading"><div><h2>{t('Метод контурных токов','Метод контурних струмів')}</h2><p>{t('Постоянный ток · От уравнений к работающей модели','Постійний струм · Від рівнянь до робочої моделі')}</p></div><span class="ref-tag">{t('● Учебный материал','● Навчальний матеріал')}</span></div>
   <article class="ref-work-card"><div class="ref-kicker">{t('Начните с понимания цепи','Почніть із розуміння кола')}</div><h3>{t('Как найти токи в разветвлённой цепи?','Як знайти струми в розгалуженому колі?')}</h3><p>{t('Выберите независимые контуры, задайте направления токов и запишите второй закон Кирхгофа. В учебнике каждый переход разобран подробно: от физического смысла до системы уравнений и проверки результата.','Виберіть незалежні контури, задайте напрями струмів та запишіть другий закон Кірхгофа. У підручнику кожен перехід розібрано докладно: від фізичного змісту до системи рівнянь та перевірки результату.')}</p><div class="ref-formula"><i>∑ U</i> = 0</div><p>{t('Продолжите в учебнике, затем разберите четыре решённых примера и измените параметры схемы в лаборатории.','Продовжуйте в підручнику. Доступність прикладів та лабораторій для кожної теми позначена у змісті.')}</p><a class="ref-button ref-primary" href={textbook}>{t('Начать изучение','Почати навчання')} →</a></article>
  </div></div></section>
</div>

---
import LaboratoryPage from "../../../../components/LaboratoryPage.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PolygonMotionLab from "../../../../components/PolygonMotionLab";
import type { Language } from "../../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const ru = language === "ru";
const title = ru ? "Аппроксимация контура" : "Апроксимація контуру";
const description = ru
  ? "Нарисуйте или откройте контур и приблизьте его суммой движений по многоугольникам и окружностям."
  : "Намалюйте або відкрийте контур і наблизьте його сумою рухів уздовж багатокутників і кіл.";
---
<BaseLayout {title} {description} {language} active="interactive" alternatePath="/interactive/fourier/polygon-motion/">
  <LaboratoryPage {language} title={title} description={description}>
    <PolygonMotionLab client:load {language} />
  </LaboratoryPage>
</BaseLayout>

---
import ToolCard, {ToolArt} from "../../../components/ToolCard";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublishedLessonManifest } from "../../../content/published-lessons";
import { resolveTopicPublication } from "../../../curriculum-publication";
import { curriculum } from "../../../curriculum";
import type { Language } from "../../../types";
import { formatMinutes, formatTopicCount, getLocale } from "../../../i18n";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}

const language = Astro.params.lang as Language;
const copy = getLocale(language);
const lessonManifest = await getPublishedLessonManifest();
const publishedCurriculum = curriculum.map((section) => ({
  ...section,
  topics: section.topics.map((topic) => ({
    ...topic,
    publication: resolveTopicPublication(lessonManifest, language, section.id, topic),
  })),
}));

---

<BaseLayout
  title={copy.topics.title}
  description={copy.topics.description}
  language={language}
  active="topics"
  alternatePath="/topics/"
>
  <section class="section catalog-page">
    <span class="eyebrow"><i></i>{copy.topics.eyebrow}</span>
    <h1>{copy.topics.heading}</h1>
    <p class="page-lead">
      {copy.topics.lead}
    </p>
    <div class="curriculum">
      {publishedCurriculum.map((section, index) => (
        <details class="curriculum-section" open={index === 0}>
          <summary class="curriculum-trigger">
            <span class="curriculum-index">{section.index}</span>
            <span><h2>{section.title[language]}</h2><p>{section.description[language]}</p></span>
            <span class="curriculum-count">{formatTopicCount(language, section.topics.length)}</span>
            <span class="curriculum-chevron">⌄</span>
          </summary>
          <div class="curriculum-static-topics catalog-card-grid">
            {section.topics.map((topic) => (
              <ToolCard title={topic.title[language]} category={`${section.index}.${topic.index} · ${formatMinutes(language,topic.duration)}`} href={topic.publication.available?topic.publication.href:undefined} description={topic.description[language].split(/[.!?]/)[0]} action={topic.publication.available?copy.actions.startLearning:copy.actions.soon}><ToolArt kind="circuit"/></ToolCard>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

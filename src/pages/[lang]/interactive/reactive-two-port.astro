---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ReactiveTwoPortLab from "../../../components/ReactiveTwoPortLab";
import {localePath} from "../../../site-path";
import type {Language} from "../../../types";

export function getStaticPaths(){return [{params:{lang:"ru"}},{params:{lang:"uk"}}];}
const language=Astro.params.lang as Language;
const ru=language==="ru";
const title=ru?"Реактивный двухполюсник":"Реактивний двополюсник";
const description=ru?"Соберите цепь из катушек и конденсаторов и исследуйте её резонансы.":"Зберіть коло з котушок і конденсаторів та дослідіть його резонанси.";
---
<BaseLayout title={title} description={description} language={language} active="interactive" alternatePath="/interactive/reactive-two-port/">
 <section class="section">
  <a href={localePath(language,"/interactive/")}>← {ru?"Все лаборатории":"Усі лабораторії"}</a>
  <h1>{title}</h1>
  <ReactiveTwoPortLab client:load language={language}/>
 </section>
</BaseLayout>

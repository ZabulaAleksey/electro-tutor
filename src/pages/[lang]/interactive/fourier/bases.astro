---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import BasisExperimentLab from "../../../../components/BasisExperimentLab";
import { localePath } from "../../../../site-path";
import type { Language } from "../../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const ru = language === "ru";
const title = ru ? "Базисные разложения сигнала и контура" : "Базисні розклади сигналу й контуру";
const description = ru
  ? "Задайте функцию или нарисуйте контур. Сравните точность Фурье, вейвлетов, Уолша и полиномиальных разложений."
  : "Задайте функцію або намалюйте контур. Порівняйте точність Фур’є, вейвлетів, Волша й поліноміальних розкладів.";
---
<BaseLayout {title} {description} {language} active="interactive" alternatePath="/interactive/fourier/bases/">
  <section class="basis-experiment-page">
    <nav aria-label={ru ? "Лаборатории" : "Лабораторії"}>
      <a href={localePath(language, "/interactive/")}>{ru ? "← Лаборатории" : "← Лабораторії"}</a>
      <a href={localePath(language, "/interactive/fourier/")}>Fourier Sketch</a>
    </nav>
    <h1>{title}</h1>
    <BasisExperimentLab client:load {language} />
  </section>
</BaseLayout>

<style>
  .basis-experiment-page { width: min(100% - 2rem, 82rem); margin: 1rem auto 3rem; }
  .basis-experiment-page h1 { margin: .55rem 0 1.1rem; font-size: clamp(1.45rem, 4vw, 2.55rem); }
  .basis-experiment-page nav { display: flex; flex-wrap: wrap; gap: 0 1rem; }
  .basis-experiment-page nav a { display: inline-flex; align-items: center; min-height: 44px; }
</style>

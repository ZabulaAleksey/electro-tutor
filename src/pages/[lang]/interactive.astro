---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CircularDiagram from "../../components/CircularDiagram";
import "../../components/CircularDiagram.css";
import type { Language } from "../../types";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}
const language = Astro.params.lang as Language;
const ru = language === "ru";
---

<BaseLayout
  title={ru ? "Интерактивные схемы — Потенциал" : "Інтерактивні схеми — Потенціал"}
  description={ru ? "Интерактивные электрические схемы, круговые и векторные диаграммы." : "Інтерактивні електричні схеми, колові та векторні діаграми."}
  language={language}
  active="interactive"
  alternatePath="/interactive/"
>
  <section class="section info-page interactive-intro">
    <span class="eyebrow"><i></i>{ru ? "Учебная лаборатория" : "Навчальна лабораторія"}</span>
    <h1>{ru ? "Интерактив" : "Інтерактив"}</h1>
    <p>{ru ? "Исследуйте режимы электрических цепей с помощью управляемых схем, векторных диаграмм и расчётных тренажёров." : "Досліджуйте режими електричних кіл за допомогою керованих схем, векторних діаграм і розрахункових тренажерів."}</p>
  </section>
  <div class="section interactive-section">
    <CircularDiagram client:load language={language} />
  </div>
</BaseLayout>

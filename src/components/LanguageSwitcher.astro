---
import type { Language } from "../types";
import { localePath } from "../site-path";
const { language, alternatePath = "/" } = Astro.props as { language: Language; alternatePath?: string };
const options = [{ value: "ru", label: "Русский" }, { value: "uk", label: "Українська" }, { value: "en", label: "English" }] as const;
const label = language === "ru" ? "Выбрать язык" : "Вибрати мову";
const optionHref = (value: (typeof options)[number]["value"]) => value === "en" ? localePath(language, alternatePath) : localePath(value, alternatePath);
---
<div class="language-switcher" data-language-switcher>
  <button class="language-switcher__trigger" type="button" aria-label={label} title={label} aria-haspopup="menu" aria-expanded="false" aria-controls="electrotutor-language-menu"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 8 3-3 3 3M8 5v9a3 3 0 0 1-3 3H3M3 12h7M14 5l5 14M16 14h6M12 19l2.5-7h5l2.5 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <div class="language-switcher__menu" id="electrotutor-language-menu" role="menu" aria-label={label} hidden>{options.map(option => <a role="menuitemradio" aria-checked={option.value === language ? "true" : "false"} class:list={{ "language-switcher__option": true, "is-active": option.value === language }} href={optionHref(option.value)} lang={option.value} data-language-option={option.value}><span>{option.label}</span>{option.value === language && <span aria-hidden="true">✓</span>}</a>)}</div>
</div>
<script is:inline>
  (() => { const root = document.querySelector('[data-language-switcher]'); if (!root || root.dataset.ready === 'true') return; root.dataset.ready = 'true'; const trigger = root.querySelector('.language-switcher__trigger'); const menu = root.querySelector('.language-switcher__menu'); const options = [...root.querySelectorAll('[data-language-option]')]; if (!(trigger instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return; const close = (restore = false) => { menu.hidden = true; trigger.setAttribute('aria-expanded', 'false'); if (restore) trigger.focus(); }; const open = (index = options.findIndex(option => option.getAttribute('aria-checked') === 'true')) => { menu.hidden = false; trigger.setAttribute('aria-expanded', 'true'); (options[Math.max(0, index)] instanceof HTMLElement) && options[Math.max(0, index)].focus(); }; trigger.addEventListener('click', () => menu.hidden ? open() : close(true)); trigger.addEventListener('keydown', event => { if (event.key === 'ArrowDown' || event.key === 'ArrowUp') { event.preventDefault(); open(event.key === 'ArrowUp' ? options.length - 1 : 0); } }); menu.addEventListener('keydown', event => { const index = options.indexOf(document.activeElement); if (event.key === 'Escape') { event.preventDefault(); close(true); } else if (event.key === 'Tab') close(); else if (['ArrowDown','ArrowUp','Home','End'].includes(event.key)) { event.preventDefault(); const last = options.length - 1; const next = event.key === 'Home' ? 0 : event.key === 'End' ? last : event.key === 'ArrowDown' ? (index + 1) % options.length : (index + last) % options.length; options[next]?.focus(); } }); document.addEventListener('pointerdown', event => { if (!root.contains(event.target)) close(); }); })();
</script>

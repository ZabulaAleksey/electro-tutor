---
import LaboratoryPage from "../../../components/LaboratoryPage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CircularDiagram from "../../../components/CircularDiagram";
import "../../../components/CircularDiagram.css";
import "../../../components/CircularDiagramMath.css";
import { getLocale } from "../../../i18n";
import type { Language } from "../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const copy = getLocale(language).diagram;
---
<BaseLayout title={`${copy.title} — ${getLocale(language).brand.display}`} description={copy.lead}
  language={language} active="interactive" alternatePath="/interactive/circular-diagram/">
  <LaboratoryPage {language} title={copy.title} description={copy.lead}>
    <CircularDiagram client:load showHeading={false} language={language} />
  </LaboratoryPage>
</BaseLayout>

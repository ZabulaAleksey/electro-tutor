---
import "katex/dist/katex.min.css";
import "../styles.css";
import "../pwa.css";
import "../landing.css";
import "../engineering/theme.css";
import "../reference-ui.css";
import type { Language } from "../types";
import { getLocale, getOtherLanguage } from "../i18n";
import { localePath, SITE_BASE_PATH, withBasePath } from "../site-path";
import { ClientRouter } from "astro:transitions";
import "../content-directory.css";
import ThemeBootstrap from "../components/ThemeBootstrap.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { themeConfiguration } from "../theme-configuration.mjs";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { contentCopy, stageCopy } from "../learning/navigation-copy";

interface Props {
  title: string; description: string; language: Language;
  active?: "home" | "topics" | "interactive" | "tools" | "engineering-board" | "board" | "classroom" | "services" | "my-services" | "contacts" | "account";
  alternatePath?: string; keywords?: string[]; hasTranslation?: boolean;
}
const { title, description, language, active = "home", alternatePath = "/", keywords = [], hasTranslation = true } = Astro.props;
const copy = getLocale(language);
const otherLanguage = getOtherLanguage(language);
const canonical = new URL(localePath(language, alternatePath), Astro.site);
const alternate = new URL(localePath(otherLanguage, alternatePath), Astro.site);
const defaultAlternate = new URL(localePath("ru", alternatePath), Astro.site);
const manifestPath = withBasePath("/manifest.webmanifest");
const iconPath = withBasePath("/icons/potential.svg");
const webFontScriptPath = withBasePath("/scripts/web-font.js");
const serviceWorkerPath = withBasePath("/sw.js");
const webFontStylesheet = "https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap";
const publicApiOrigin = import.meta.env.PUBLIC_API_ORIGIN || "";
const myServicesLabel = language === "ru" ? "Сервисы" : "Сервіси";
const standardNav = [
  { id: "topics", href: localePath(language, "/topics/"), label: stageCopy[language].textbook },
  { id: "interactive", href: localePath(language, "/interactive/"), label: contentCopy[language].labs },
  { id: "tools", href: localePath(language, "/tools/"), label: contentCopy[language].tools },
  { id: "home", href: localePath(language), label: copy.nav.home },
  { id: "board", href: localePath(language, "/board/"), label: language === "ru" ? "Доска" : "Дошка" },
  { id: "classroom", href: localePath(language, "/classroom/"), label: language === "ru" ? "Репетиторство" : "Репетиторство" },
  { id: "my-services", href: localePath(language, "/my-services/"), label: myServicesLabel },
  { id: "contacts", href: localePath(language, "/contacts/"), label: language === "ru" ? "Контакты" : "Контакти" },
];
// Home and internal pages deliberately share the same shell navigation.
const nav = standardNav;
---
<!doctype html>
<html lang={language} data-theme="light" data-base-path={SITE_BASE_PATH} data-service-worker-path={serviceWorkerPath}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="electro-tutor-api-origin" content={publicApiOrigin} />
  <meta name="theme-color" content={themeConfiguration.chromeColor} />
  <meta name="description" content={description} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content={copy.brand.display} />
  {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
  <link rel="manifest" href={manifestPath} />
  <link rel="icon" href={iconPath} type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
  {hasTranslation && <link rel="alternate" hreflang={otherLanguage} href={alternate} />}
  <link rel="alternate" hreflang={language} href={canonical} />
  <link rel="alternate" hreflang="x-default" href={defaultAlternate} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href={webFontStylesheet} />
  <link rel="stylesheet" href={webFontStylesheet} media="print" data-web-font-stylesheet />
  <script is:inline src={webFontScriptPath} defer></script>
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <title>{title}</title>
  <ClientRouter />
  <ThemeBootstrap />
</head>
<body data-home={active === "home" ? "true" : undefined}>
  <header class="header astro-header">
    <a class="brand" href={localePath(language)} aria-label={copy.brand.display}>
      <svg class="brand-mark" viewBox="0 0 72 48" aria-hidden="true"><defs><linearGradient id="brand-wave" x2="1" y2=".2"><stop stop-color="#45d4ff"/><stop offset="1" stop-color="#874fff"/></linearGradient></defs><path d="M4 36 L16 12 Q21 2 25 13 L31 35 Q35 45 40 30 L47 13 Q52 3 56 18 L61 33 Q65 43 69 21" fill="none" stroke="url(#brand-wave)" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span><strong>{copy.brand.display}</strong><small>{copy.brand.tagline}</small></span>
    </a>
    <nav aria-label={copy.nav.label}>
      {nav.map(item => item.id === "my-services" ? <details class="nav-services"><summary aria-label={language === "ru" ? "Дополнительные сервисы" : "Додаткові сервіси"} class:list={{active:active === item.id}}>{item.label}</summary><div class="nav-services-menu"><a href={localePath(language,"/my-services/#install")}>{language==="ru"?"Приложение ElectroTutor":"Застосунок ElectroTutor"}</a><a href={localePath(language,"/my-services/#mathmorph")}>MathMorph</a><a href={localePath(language,"/classroom/")}>{language==="ru"?"Гостевая видеокомната · Jitsi (внешний сервис)":"Гостьова відеокімната · Jitsi (зовнішній сервіс)"}</a><span>{language==="ru"?"Контролируемое видеозанятие · не реализовано":"Кероване відеозаняття · не реалізовано"}</span><a href={item.href}>{language==="ru"?"Все сервисы":"Усі сервіси"} ↗</a></div></details> : <a class:list={{ active: active === item.id }} aria-current={active === item.id && Astro.url.pathname === item.href ? "page" : undefined} href={item.href}>{item.label}</a>)}
    </nav>
    {hasTranslation && <LanguageSwitcher language={language} alternatePath={alternatePath} />}
    {themeConfiguration.allowDark && <ThemeToggle label={copy.actions.theme} />}
    <button class="mobile-menu-toggle" id="mobile-menu-toggle" type="button" aria-expanded="false" aria-label={copy.actions.openMenu}>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </header>
  <main><slot /></main>
  <footer><span>© {new Date().getFullYear()} {copy.brand.display}</span></footer>

  <dialog class="install-dialog" id="install-dialog" aria-labelledby="install-dialog-title">
    <div class="install-dialog-content">
      <h2 id="install-dialog-title">{copy.install.title}</h2>
      <p>{copy.install.description}</p>
      <ol data-ios-steps hidden>
        <li>{copy.install.stepShare}</li>
        <li>{copy.install.stepHome}</li>
        <li>{copy.install.stepAdd}</li>
      </ol>
      <form method="dialog"><button class="button primary">{copy.actions.understood}</button></form>
    </div>
  </dialog>

  <script>
    import { mountLearningSummary } from "../learning/summary";
    document.addEventListener("astro:page-load", mountLearningSummary);
    mountLearningSummary();
  </script>

  <script is:inline>
    (() => {
      const state = window.__potentialUi ||= { installPrompt: null, globalEventsReady: false };

      const closeMobileMenu = () => {
        const header = document.querySelector(".astro-header");
        const toggle = document.querySelector("#mobile-menu-toggle");
        header?.classList.remove("mobile-open");
        toggle?.setAttribute("aria-expanded", "false");
        document.querySelectorAll("details.nav-services").forEach(detail => detail.open = false);
      };

      const restoreLanguageScroll = () => {
        let saved = null;
        try { saved = sessionStorage.getItem("potential-language-scroll"); } catch {}
        if (!saved) return;
        try { sessionStorage.removeItem("potential-language-scroll"); } catch {}
        try {
          const scroll = JSON.parse(saved);
          if (scroll.path === location.pathname && Number.isFinite(scroll.y)) {
            requestAnimationFrame(() => requestAnimationFrame(() => scrollTo(0, scroll.y)));
          }
        } catch {}
      };

      const initializePageControls = () => {
        const header = document.querySelector(".astro-header");
        const menuToggle = document.querySelector("#mobile-menu-toggle");
        const installButton = document.querySelector("#app-install");
        const installDialog = document.querySelector("#install-dialog");
        const iosSteps = installDialog?.querySelector("[data-ios-steps]");
        const standalone = matchMedia("(display-mode: standalone)").matches || navigator.standalone === true;
        const ios = /iphone|ipad|ipod/i.test(navigator.userAgent);

        if (menuToggle) menuToggle.onclick = () => {
          const open = header?.classList.toggle("mobile-open") ?? false;
          menuToggle.setAttribute("aria-expanded", String(open));
        };
        header?.querySelectorAll("nav a").forEach(link => link.onclick = closeMobileMenu);

        if (standalone) installButton?.setAttribute("hidden", "");
        if (installButton) installButton.onclick = async () => {
          if (state.installPrompt) {
            await state.installPrompt.prompt();
            const result = await state.installPrompt.userChoice;
            if (result.outcome === "accepted") installButton.setAttribute("hidden", "");
            state.installPrompt = null;
            return;
          }
          if (iosSteps) iosSteps.hidden = !ios;
          installDialog?.showModal();
        };

        restoreLanguageScroll();
      };

      if (!state.globalEventsReady) {
        state.globalEventsReady = true;
        document.addEventListener("click", event => {
          const origin = event.target;
          const link = origin instanceof Element ? origin.closest("[data-language-link], [data-language-option]") : null;
          if (!(link instanceof HTMLAnchorElement)) return;
          const target = new URL(link.href);
          target.search = location.search;
          target.hash = location.hash;
          link.href = target.toString();
          const selectedLanguage = link.getAttribute("lang");
          if (selectedLanguage === "ru" || selectedLanguage === "uk") {
            try { localStorage.setItem("potential-language", selectedLanguage); } catch {}
          }
          try { sessionStorage.setItem("potential-language-scroll", JSON.stringify({ path: target.pathname, y: scrollY })); } catch {}
        }, true);
        addEventListener("keydown", event => {
          if (event.key === "Escape") closeMobileMenu();
        });
        addEventListener("beforeinstallprompt", event => {
          event.preventDefault();
          state.installPrompt = event;
        });
        addEventListener("appinstalled", () => {
          document.querySelector("#app-install")?.setAttribute("hidden", "");
        });
        document.addEventListener("astro:page-load", initializePageControls);
        if ("serviceWorker" in navigator) {
          addEventListener("load", () => {
            const root = document.documentElement;
            const scriptURL = root.dataset.serviceWorkerPath;
            const scope = root.dataset.basePath;
            if (scriptURL && scope) navigator.serviceWorker.register(scriptURL, { scope }).catch(() => {});
          }, { once: true });
        }
      }

      initializePageControls();
    })();
  </script>
</body>
</html>

---
import { render } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import MeshTextbook from "../../../../components/MeshTextbook.astro";
import MeshLessonIsland from "../../../../components/MeshLessonIsland";
import { resolveInteractiveComponent } from "../../../../content/interactive-registry";
import { getPublishedLessonManifest } from "../../../../content/published-lessons";
import type { Language } from "../../../../types";
import { getLocale } from "../../../../i18n";
import TopicResources from "../../../../components/TopicResources.astro";
import { getContentCatalogue } from "../../../../learning/get-content-catalogue";
import { contentCopy } from "../../../../learning/navigation-copy";
import { localePath } from "../../../../site-path";
import MeshJourney from "../../../../mvp/MeshJourney.astro";

export async function getStaticPaths() {
  const lessons = await getPublishedLessonManifest();
  return lessons.map((lesson) => ({
    params: {
      lang: lesson.language,
      section: lesson.section,
      slug: lesson.slug,
    },
    props: { entry: lesson.entry },
  }));
}

const { entry } = Astro.props;
const language = entry.data.language as Language;
const copy = getLocale(language);
const { Content } = await render(entry);
const { subjects } = await getContentCatalogue(language);
const href = localePath(language, `/topics/${entry.data.section}/${entry.data.slug}/`);
const topic = subjects.find(subject => subject.id === entry.data.section)?.topics.find(topic => topic.theory === href);
const alternatePath = `/topics/${entry.data.section}/${entry.data.slug}/`;
const registeredInteractive = resolveInteractiveComponent(entry.data.interactive);
// Astro's hydration transform must see the concrete component import in this module.
const hasMeshInteractive = registeredInteractive === MeshLessonIsland;
---

<BaseLayout
  title={`${entry.data.title} — ${copy.lesson.brandSeparator}`}
  description={entry.data.description}
  language={language}
  active="topics"
  alternatePath={alternatePath}
  keywords={entry.data.keywords}
>
  {hasMeshInteractive && language === "ru" ? (
    <MeshJourney stage={0} animated={false}><MeshTextbook><Content /></MeshTextbook></MeshJourney>
  ) : (
    <>
      <article class="lesson-intro">
        {!registeredInteractive ? <h1>{entry.data.title}</h1> : null}
        <Content />
      </article>
      {hasMeshInteractive ? <MeshLessonIsland language={language} client:load /> : null}
    </>
  )}
  {topic && (topic.labs.length > 0 || topic.tools.length > 0 || topic.examples) && (
    <section class="content-directory" aria-labelledby="related-title">
      <h2 id="related-title">{contentCopy[language].topicResources}</h2>
      <TopicResources {topic} {language} showTheory={false} />
    </section>
  )}
</BaseLayout>

---
import BaseLayout from "../../../../../../layouts/BaseLayout.astro";
import Content from "../../../../../../content/mesh-examples/ru.mdx";
import { localePath } from "../../../../../../site-path";
import MeshJourney from "../../../../../../mvp/MeshJourney.astro";
const textbook = localePath("ru", "/topics/dc/mesh-current-method/");
---
<BaseLayout title="Метод контурных токов — примеры решений — ElectroTutor" description="Четыре подробных примера: один и два источника, отрицательный ток, три контура, источник тока и суперконтур. Проверки Кирхгофа и мощности." language="ru" active="topics" alternatePath="/topics/dc/mesh-current-method/examples/" hasTranslation={false}>
  <MeshJourney stage={1} animated={false}><div class="mesh-examples-page">
    <article class="lesson-content mesh-examples">
      <a class="examples-back" href={textbook}>← Учебник: метод контурных токов</a>
      <header class="lesson-header"><span class="lesson-number">ПРИМЕРЫ РЕШЕНИЙ · ПОСТОЯННЫЙ ТОК</span><h1>Метод контурных токов: примеры решений</h1><p>Четыре задачи с последовательным усложнением, полными выводами и независимыми проверками.</p></header>
      <nav class="textbook-toc" aria-label="Примеры решений">
        <a href="#example-1">1. Один источник</a><a href="#example-2">2. Два источника и отрицательный ток</a><a href="#example-3">3. Три контура</a><a href="#example-4">4. Источник тока и суперконтур</a>
      </nav>
      <Content />
      <section class="mesh-examples-entry" aria-labelledby="mesh-lab-link-title">
        <h2 id="mesh-lab-link-title">Проверьте схемы в лаборатории</h2>
        <p>Изменяйте сопротивления и источники, сравнивайте токи, напряжения и баланс мощности.</p>
        <nav aria-label="Схемы лаборатории"><ul>{[1,2,3,4].map(n => <li><a href={`${localePath("ru", "/topics/dc/mesh-current-method/lab/")}?example=${n}`}>Открыть в лаборатории пример {n} →</a></li>)}</ul></nav>
      </section>
      <p><a class="examples-back" href={textbook}>Вернуться к подробному учебнику</a></p>
    </article>
  </div></MeshJourney>
</BaseLayout>

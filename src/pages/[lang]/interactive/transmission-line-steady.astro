---
import CompatibilityRedirect from "../../../components/CompatibilityRedirect.astro";
import type { Language } from "../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const ru = language === "ru";
const title = ru ? "Длинная линия в синусоидальном режиме" : "Довга лінія в синусоїдному режимі";
const description = ru ? "Прямые и отражённые фазоры напряжения и тока вдоль линии." : "Прямі та відбиті фазори напруги й струму вздовж лінії.";
---
<CompatibilityRedirect language={language} destinationPath="/interactive/transmission-line-steady/experiment/" alternatePath="/interactive/transmission-line-steady/" title={title} description={description} />

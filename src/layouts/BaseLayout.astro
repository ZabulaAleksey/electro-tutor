---
import "katex/dist/katex.min.css";
import "../styles.css";
import type { Language } from "../types";

interface Props {
  title: string;
  description: string;
  language: Language;
  active?: "home" | "topics" | "interactive" | "services" | "contacts";
  alternatePath?: string;
  keywords?: string[];
}

const {
  title,
  description,
  language,
  active = "home",
  alternatePath = "/",
  keywords = [],
} = Astro.props;

const ru = language === "ru";
const otherLanguage = ru ? "uk" : "ru";
const currentPath = Astro.url.pathname;
const canonical = new URL(currentPath, Astro.site);
const alternate = new URL(`/${otherLanguage}${alternatePath}`, Astro.site);

const nav = [
  { id: "home", href: `/${language}/`, ru: "Главная", uk: "Головна" },
  { id: "topics", href: `/${language}/topics/`, ru: "Все темы", uk: "Усі теми" },
  { id: "interactive", href: `/${language}/interactive/`, ru: "Интерактив", uk: "Інтерактив" },
  { id: "services", href: `/${language}/services/`, ru: "Услуги", uk: "Послуги" },
  { id: "contacts", href: `/${language}/contacts/`, ru: "Контакты", uk: "Контакти" },
];
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f3ee" />
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={otherLanguage} href={alternate} />
    <link rel="alternate" hreflang={language} href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("potential-theme");
        const theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="header astro-header">
      <a class="brand" href={`/${language}/`} aria-label={ru ? "Потенциал" : "Потенціал"}>
        <span class="brand-mark" aria-hidden="true">∿</span>
        <span>
          <strong>{ru ? "ПОТЕНЦИАЛ" : "ПОТЕНЦІАЛ"}</strong>
          <small>{ru ? "Инженерный учебник" : "Інженерний підручник"}</small>
        </span>
      </a>
      <nav aria-label={ru ? "Основная навигация" : "Головна навігація"}>
        {nav.map((item) => (
          <a class:list={{ active: active === item.id }} href={item.href}>
            {item[language]}
          </a>
        ))}
      </nav>
      <button
        class="theme-toggle"
        id="theme-toggle"
        aria-label={ru ? "Переключить тему" : "Перемкнути тему"}
        title={ru ? "Светлая / тёмная тема" : "Світла / темна тема"}
      >
        <span class="theme-light">☾</span>
        <span class="theme-dark">☀</span>
      </button>
      <a class="language-link" href={`/${otherLanguage}${alternatePath}`}>
        {ru ? "UA" : "RU"}
      </a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <span>© 2026 {ru ? "Потенциал" : "Потенціал"}</span>
      <span>{ru ? "Учимся понимать, а не запоминать." : "Вчимося розуміти, а не запам’ятовувати."}</span>
    </footer>
    <script is:inline>
      const toggle = document.querySelector("#theme-toggle");
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("potential-theme", next);
      });
    </script>
  </body>
</html>

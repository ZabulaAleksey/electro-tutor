---
import LaboratoryPage from "../../../../components/LaboratoryPage.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import TopologyWorkbench from "../../../../circuit/TopologyWorkbench";
import { getLocale } from "../../../../i18n";
import type { Language } from "../../../../types";
import reference from "../../../../../tests/topology-eval/stage-2-proposed.json";

export function getStaticPaths() {
  return ["ru", "uk"].map(lang => ({ params: { lang } }));
}
const language = Astro.params.lang as Language;
const ru = language === "ru";
const title = ru ? "Топологическая схема" : "Топологічна схема";
const description = ru
  ? "Лабораторный режим с автоматической компоновкой электрических схем."
  : "Лабораторний режим з автоматичним компонуванням електричних схем.";
const alternatePath = "/interactive/circuit-editor/topology/";
---
<BaseLayout title={`${title} · ${getLocale(language).brand.display}`} description={description}
  language={language} active="interactive" alternatePath={alternatePath}>
  <LaboratoryPage {language} title={title} description={description}>
    <TopologyWorkbench client:load language={language} referenceJson={JSON.stringify(reference.document)} />
  </LaboratoryPage>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Language } from "../../types";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}

const language = Astro.params.lang as Language;
const ru = language === "ru";
const bookingUrl = import.meta.env.PUBLIC_CALCOM_URL;
---

<BaseLayout
  title={ru ? "Услуги и консультации — Потенциал" : "Послуги та консультації — Потенціал"}
  description={ru ? "Индивидуальные занятия, консультации и дополнительные материалы по электротехнике." : "Індивідуальні заняття, консультації та додаткові матеріали з електротехніки."}
  language={language}
  active="services"
  alternatePath="/services/"
>
  <section class="section services-page">
    <span class="eyebrow"><i></i>{ru ? "Обучение и материалы" : "Навчання та матеріали"}</span>
    <h1>{ru ? "Услуги" : "Послуги"}</h1>
    <p class="page-lead">{ru ? "Выберите формат помощи. Стоимость и способы оплаты будут подключены после выбора платёжного провайдера." : "Оберіть формат допомоги. Вартість і способи оплати буде підключено після вибору платіжного провайдера."}</p>
    <div class="service-grid">
      <article class="service-card featured">
        <span class="service-tag">{ru ? "Онлайн" : "Онлайн"}</span>
        <h2>{ru ? "Индивидуальная консультация" : "Індивідуальна консультація"}</h2>
        <p>{ru ? "Разбор темы, задачи или расчётной работы в согласованное время." : "Розбір теми, задачі або розрахункової роботи в узгоджений час."}</p>
        <ul>
          <li>{ru ? "Выбор свободного времени" : "Вибір вільного часу"}</li>
          <li>{ru ? "Ваши материалы и задачи" : "Ваші матеріали та задачі"}</li>
          <li>{ru ? "Онлайн-встреча" : "Онлайн-зустріч"}</li>
        </ul>
        {bookingUrl
          ? <a class="button primary" href={bookingUrl} target="_blank" rel="noreferrer">{ru ? "Выбрать время" : "Обрати час"} →</a>
          : <span class="integration-note">{ru ? "Календарь будет подключён через Cal.com" : "Календар буде підключено через Cal.com"}</span>}
      </article>
      <article class="service-card">
        <span class="service-tag">{ru ? "Цифровой материал" : "Цифровий матеріал"}</span>
        <h2>{ru ? "Дополнительные материалы" : "Додаткові матеріали"}</h2>
        <p>{ru ? "Подборки задач, подробные решения, памятки и расчётные шаблоны." : "Добірки задач, докладні розв’язання, пам’ятки та розрахункові шаблони."}</p>
        <span class="integration-note">{ru ? "Каталог готовится" : "Каталог готується"}</span>
      </article>
      <article class="service-card">
        <span class="service-tag">{ru ? "Проверка" : "Перевірка"}</span>
        <h2>{ru ? "Разбор готового решения" : "Розбір готового розв’язання"}</h2>
        <p>{ru ? "Проверка формул, схем, вычислений и оформление замечаний." : "Перевірка формул, схем, обчислень та оформлення зауважень."}</p>
        <span class="integration-note">{ru ? "Приём заявок будет добавлен позже" : "Приймання заявок буде додано пізніше"}</span>
      </article>
    </div>
    <section class="booking-section">
      <span class="section-kicker">{ru ? "РАСПИСАНИЕ" : "РОЗКЛАД"}</span>
      <h2>{ru ? "Вы сами управляете доступными часами" : "Ви самі керуєте доступними годинами"}</h2>
      <p>{ru ? "Cal.com синхронизируется с календарём на смартфоне, учитывает занятые события, часовые пояса, перерывы и минимальный срок записи." : "Cal.com синхронізується з календарем на смартфоні, враховує зайняті події, часові пояси, перерви та мінімальний термін запису."}</p>
    </section>
  </section>
</BaseLayout>

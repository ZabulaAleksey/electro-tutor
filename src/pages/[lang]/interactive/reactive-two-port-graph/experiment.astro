---
import LaboratoryPage from "../../../../components/LaboratoryPage.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import LcExperimentLab from "../../../../components/LcExperimentLab";
import type { Language } from "../../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const ru = language === "ru";
const title = ru ? "LC-двухполюсник" : "LC-двополюсник";
const description = ru
  ? "Соберите схему из катушек и конденсаторов. Исследуйте её входной импеданс и резонансы."
  : "Зберіть схему з котушок і конденсаторів. Дослідіть її вхідний імпеданс і резонанси.";
---
<BaseLayout {title} {description} {language}
  active="interactive" alternatePath="/interactive/reactive-two-port-graph/experiment/">
  <LaboratoryPage {language} title={title} description={description}>
    <LcExperimentLab client:load {language} />
  </LaboratoryPage>
</BaseLayout>

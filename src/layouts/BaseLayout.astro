---
import "katex/dist/katex.min.css";
import "../styles.css";
import "../pwa.css";
import type { Language } from "../types";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string; description: string; language: Language;
  active?: "home" | "topics" | "interactive" | "classroom" | "services" | "contacts";
  alternatePath?: string; keywords?: string[];
}
const { title, description, language, active = "home", alternatePath = "/", keywords = [] } = Astro.props;
const ru = language === "ru", otherLanguage = ru ? "uk" : "ru";
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(`/${otherLanguage}${alternatePath}`, Astro.site);
const nav = [
  { id: "home", href: `/${language}/`, ru: "Главная", uk: "Головна" },
  { id: "topics", href: `/${language}/topics/`, ru: "Все темы", uk: "Усі теми" },
  { id: "interactive", href: `/${language}/interactive/`, ru: "Интерактив", uk: "Інтерактив" },
  { id: "classroom", href: `/${language}/classroom/`, ru: "Кабинет", uk: "Кабінет" },
  { id: "services", href: `/${language}/services/`, ru: "Услуги", uk: "Послуги" },
  { id: "contacts", href: `/${language}/contacts/`, ru: "Контакты", uk: "Контакти" },
];
---
<!doctype html>
<html lang={language}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#246b54" />
  <meta name="description" content={description} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content={ru ? "Потенциал" : "Потенціал"} />
  {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/icons/potential.svg" type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={otherLanguage} href={alternate} />
  <link rel="alternate" hreflang={language} href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <title>{title}</title>
  <ClientRouter />
  <script is:inline>
    (() => {
      const saved = localStorage.getItem("potential-theme");
      document.documentElement.dataset.theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    })();
  </script>
</head>
<body>
  <header class="header astro-header">
    <a class="brand" href={`/${language}/`} aria-label={ru ? "Потенциал" : "Потенціал"}>
      <span class="brand-mark" aria-hidden="true">∿</span>
      <span><strong>{ru ? "ПОТЕНЦИАЛ" : "ПОТЕНЦІАЛ"}</strong><small>{ru ? "Инженерный учебник" : "Інженерний підручник"}</small></span>
    </a>
    <nav aria-label={ru ? "Основная навигация" : "Головна навігація"}>
      {nav.map(item => <a class:list={{ active: active === item.id }} href={item.href}>{item[language]}</a>)}
    </nav>
    <button class="mobile-menu-toggle" id="mobile-menu-toggle" type="button" aria-expanded="false" aria-label={ru ? "Открыть меню" : "Відкрити меню"}>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
    <button class="app-install-link" id="app-install" type="button" aria-label={ru ? "Установить приложение" : "Встановити застосунок"}>
      <span class="app-install-icon" aria-hidden="true">⇩</span><span class="app-install-label">{ru ? "Приложение" : "Застосунок"}</span>
    </button>
    <button class="theme-toggle" id="theme-toggle" aria-label={ru ? "Переключить тему" : "Перемкнути тему"} title={ru ? "Светлая / тёмная тема" : "Світла / темна тема"}>
      <span class="theme-light">☾</span><span class="theme-dark">☀</span>
    </button>
    <a class="language-link" data-language-link href={`/${otherLanguage}${alternatePath}`}>{ru ? "UA" : "RU"}</a>
  </header>
  <main><slot /></main>
  <footer><span>© 2026 {ru ? "Потенциал" : "Потенціал"}</span><span>{ru ? "Учимся понимать, а не запоминать." : "Вчимося розуміти, а не запам’ятовувати."}</span></footer>

  <dialog class="install-dialog" id="install-dialog">
    <div class="install-dialog-content">
      <h2>{ru ? "Установить приложение" : "Встановити застосунок"}</h2>
      <p>{ru ? "Установите «Потенциал» на главный экран и открывайте учебник как обычное приложение." : "Встановіть «Потенціал» на головний екран і відкривайте підручник як звичайний застосунок."}</p>
      <ol data-ios-steps hidden>
        <li>{ru ? "Откройте меню «Поделиться» в Safari." : "Відкрийте меню «Поділитися» у Safari."}</li>
        <li>{ru ? "Выберите «На экран Домой»." : "Виберіть «На початковий екран»."}</li>
        <li>{ru ? "Нажмите «Добавить»." : "Натисніть «Додати»."}</li>
      </ol>
      <form method="dialog"><button class="button primary">{ru ? "Понятно" : "Зрозуміло"}</button></form>
    </div>
  </dialog>

  <script is:inline>
    (() => {
      const state = window.__potentialUi ||= { installPrompt: null, globalEventsReady: false };

      const applySavedTheme = () => {
        const saved = localStorage.getItem("potential-theme");
        document.documentElement.dataset.theme = saved
          || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      };

      const closeMobileMenu = () => {
        const header = document.querySelector(".astro-header");
        const toggle = document.querySelector("#mobile-menu-toggle");
        header?.classList.remove("mobile-open");
        toggle?.setAttribute("aria-expanded", "false");
      };

      const restoreLanguageScroll = () => {
        const saved = sessionStorage.getItem("potential-language-scroll");
        if (!saved) return;
        sessionStorage.removeItem("potential-language-scroll");
        try {
          const scroll = JSON.parse(saved);
          if (scroll.path === location.pathname && Number.isFinite(scroll.y)) {
            requestAnimationFrame(() => requestAnimationFrame(() => scrollTo(0, scroll.y)));
          }
        } catch {}
      };

      const initializePageControls = () => {
        applySavedTheme();
        const header = document.querySelector(".astro-header");
        const menuToggle = document.querySelector("#mobile-menu-toggle");
        const themeToggle = document.querySelector("#theme-toggle");
        const installButton = document.querySelector("#app-install");
        const installDialog = document.querySelector("#install-dialog");
        const iosSteps = installDialog?.querySelector("[data-ios-steps]");
        const standalone = matchMedia("(display-mode: standalone)").matches || navigator.standalone === true;
        const ios = /iphone|ipad|ipod/i.test(navigator.userAgent);

        if (menuToggle) menuToggle.onclick = () => {
          const open = header?.classList.toggle("mobile-open") ?? false;
          menuToggle.setAttribute("aria-expanded", String(open));
        };
        header?.querySelectorAll("nav a").forEach(link => link.onclick = closeMobileMenu);

        if (themeToggle) themeToggle.onclick = () => {
          const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          localStorage.setItem("potential-theme", next);
        };

        if (standalone) installButton?.setAttribute("hidden", "");
        if (installButton) installButton.onclick = async () => {
          if (state.installPrompt) {
            await state.installPrompt.prompt();
            const result = await state.installPrompt.userChoice;
            if (result.outcome === "accepted") installButton.setAttribute("hidden", "");
            state.installPrompt = null;
            return;
          }
          if (iosSteps) iosSteps.hidden = !ios;
          installDialog?.showModal();
        };

        restoreLanguageScroll();
      };

      if (!state.globalEventsReady) {
        state.globalEventsReady = true;
        document.addEventListener("click", event => {
          const origin = event.target;
          const link = origin instanceof Element ? origin.closest("[data-language-link]") : null;
          if (!(link instanceof HTMLAnchorElement)) return;
          const target = new URL(link.href);
          target.search = location.search;
          target.hash = location.hash;
          link.href = target.toString();
          sessionStorage.setItem("potential-language-scroll", JSON.stringify({ path: target.pathname, y: scrollY }));
        }, true);
        addEventListener("keydown", event => {
          if (event.key === "Escape") closeMobileMenu();
        });
        addEventListener("beforeinstallprompt", event => {
          event.preventDefault();
          state.installPrompt = event;
        });
        addEventListener("appinstalled", () => {
          document.querySelector("#app-install")?.setAttribute("hidden", "");
        });
        document.addEventListener("astro:page-load", initializePageControls);
        if ("serviceWorker" in navigator) {
          addEventListener("load", () => navigator.serviceWorker.register("/sw.js"), { once: true });
        }
      }

      initializePageControls();
    })();
  </script>
</body>
</html>

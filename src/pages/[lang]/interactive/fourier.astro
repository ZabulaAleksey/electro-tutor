---
import CompatibilityRedirect from "../../../components/CompatibilityRedirect.astro";
import type { Language } from "../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const title = language === "ru" ? "Аппроксимация контура" : "Апроксимація контуру";
const description = language === "ru"
  ? "Откройте круговые движения Фурье в лаборатории аппроксимации контура."
  : "Відкрийте колові рухи Фур’є в лабораторії апроксимації контуру.";
const destination = "/interactive/fourier/polygon-motion/";
---
<CompatibilityRedirect {language} {title} {description} destinationPath={destination + "?method=fourier"} alternatePath={destination} />

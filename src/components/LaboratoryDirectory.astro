---
import DirectorySearch from "./DirectorySearch.astro";
import TopicCover from "../catalogue/TopicCover";
import { catalogueItems, showcaseLaboratories } from "../catalogue/catalog";
import { localePath } from "../site-path";
import type { Language } from "../types";

interface Props { language: Language; home?: boolean }
const { language, home = false } = Astro.props;
const title = language === "ru" ? "Лаборатории" : "Лабораторії";
const directoryLaboratories = catalogueItems.filter((lab) => lab.available && (lab.languages === undefined || lab.languages.includes(language)));
---
<section class="content-directory lab-directory" id="labs" aria-labelledby="lab-directory-title">
  {home ? <h2 id="lab-directory-title">{title}</h2> : <h1 id="lab-directory-title">{title}</h1>}
  {!home && <DirectorySearch {language} />}
  <ul class="directory-grid" data-directory-group>
    {(home ? showcaseLaboratories : directoryLaboratories).map(lab => {
      const href = localePath(language, lab.href);
      const alias = showcaseLaboratories.find(featured => featured.id === lab.id)?.title[language];
      return <li class="directory-card lab-directory-card" data-directory-entry data-directory-alias={alias}>
        <a class="lab-directory-card-link" href={href} data-registered-content={href} aria-labelledby={`lab-${lab.id.replaceAll(":", "-")}-title`}>
          <div aria-hidden="true"><TopicCover kind={lab.visual} /></div>
          <h3 id={`lab-${lab.id.replaceAll(":", "-")}-title`}>{lab.title[language]}</h3>
          {lab.description && <p id={`lab-${lab.id.replaceAll(":", "-")}-description`}>{lab.description[language]}</p>}
        </a>
      </li>;
    })}
  </ul>
</section>
<style>
  .lab-directory .directory-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1rem; }
  .lab-directory-card { padding: 0; }
  .lab-directory-card-link { display: block; height: 100%; padding: .8rem; color: inherit; text-decoration: none; border-radius: .65rem; }
  .lab-directory-card-link:hover, .lab-directory-card-link:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .lab-directory-card h3 { margin: .8rem 0 .25rem; font-size: 1.05rem; color: var(--accent); text-decoration: underline; }
  .lab-directory-card :global(.topic-cover) { width: 100%; height: 6rem; }
</style>

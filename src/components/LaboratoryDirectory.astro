---
import DirectorySearch from "./DirectorySearch.astro";
import TopicCover from "../catalogue/TopicCover";
import { showcaseLaboratories } from "../catalogue/catalog";
import { localePath } from "../site-path";
import type { Language } from "../types";

interface Props { language: Language; home?: boolean }
const { language, home = false } = Astro.props;
const title = language === "ru" ? "Лаборатории" : "Лабораторії";
---
<section class="content-directory lab-directory" id="labs" aria-labelledby="lab-directory-title">
  {home ? <h2 id="lab-directory-title">{title}</h2> : <h1 id="lab-directory-title">{title}</h1>}
  {!home && <DirectorySearch {language} />}
  <ul class="directory-grid" data-directory-group>
    {showcaseLaboratories.map(lab => {
      const href = localePath(language, lab.href);
      return <li class="directory-card lab-directory-card" data-directory-entry>
        <div aria-hidden="true"><TopicCover kind={lab.visual} /></div>
        <h3><a href={href} data-registered-content={href}>{lab.title[language]}</a></h3>
        {lab.description && <p>{lab.description[language]}</p>}
      </li>;
    })}
  </ul>
</section>
<style>
  .lab-directory .directory-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1rem; }
  .lab-directory-card { padding: .8rem; }
  .lab-directory-card h3 { margin: .8rem 0 .25rem; font-size: 1.05rem; }
  .lab-directory-card h3 a { display: inline-block; padding-block: .35rem; }
  .lab-directory-card :global(.topic-cover) { width: 100%; height: 6rem; }
</style>

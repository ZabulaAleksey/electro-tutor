---
import LaboratoryPage from "../../../components/LaboratoryPage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PowerSystemLab from "../../../components/PowerSystemLab";
import type { Language } from "../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const ru = language === "ru";
const title = ru ? "Электрические системы и сети" : "Електричні системи й мережі";
const description = ru
  ? "Настройте шины, питающие источники, линии и трансформаторы."
  : "Налаштуйте шини, джерела живлення, лінії та трансформатори.";
---
<BaseLayout title={title} description={description} language={language} active="interactive" alternatePath="/interactive/power-system/">
  <LaboratoryPage {language} title={title} description={description}>
    <PowerSystemLab client:load language={language} />
  </LaboratoryPage>
</BaseLayout>

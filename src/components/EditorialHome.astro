---
import LaboratoryDirectory from "./LaboratoryDirectory.astro";
import { localePath, withBasePath } from "../site-path";
import type { Language } from "../types";
import "../editorial-home.css";

const { language } = Astro.props as { language: Language };
const text = {
  ru: {
    title: "Электротехника", titleEnd: "на практике",
    description: "Выберите тему, соберите схему и проследите, как меняются токи, напряжения и графики.",
    heroAlt: "Проволочный резистор с измерительными проводами на лабораторном столе",
    explore: "Выбрать лабораторию",
  },
  uk: {
    title: "Електротехніка", titleEnd: "на практиці",
    description: "Оберіть тему, зберіть схему та простежте, як змінюються струми, напруги й графіки.",
    heroAlt: "Дротяний резистор з вимірювальними проводами на лабораторному столі",
    explore: "Обрати лабораторію",
  },
}[language];
const image = (name: string, width: number) => withBasePath(`/panoramas/${name}-${width}.webp`);
const srcset = (name: string) => [640, 1280, 1920].map(width => `${image(name, width)} ${width}w`).join(", ");
---
<div class="editorial-home">
  <section class="editorial-hero" aria-labelledby="editorial-title">
    <div class="editorial-hero-copy">
      <h1 id="editorial-title">{text.title}<br />{text.titleEnd}</h1>
      <p>{text.description}</p>
      <a class="editorial-action" href={localePath(language, "/interactive/")}>{text.explore} <span aria-hidden="true">↗</span></a>
    </div>
    <img class="editorial-hero-image" src={image("dc", 1280)} srcset={srcset("dc")}
      sizes="(max-width: 740px) 100vw, 58vw" width="1280" height="720" alt={text.heroAlt} fetchpriority="high" />
  </section>
  <LaboratoryDirectory {language} home />
</div>

---
import type { Language } from "../types";
import { getLocale, SUPPORTED_LANGUAGES } from "../i18n";
import { localePath } from "../site-path";
const { language, alternatePath = "/" } = Astro.props as { language: Language; alternatePath?: string };
const labels = { ru: "Русский", uk: "Українська" };
const label = getLocale(language).actions.chooseLanguage;
---
<div class="language-switcher" data-language-switcher>
  <button class="language-switcher__trigger" type="button" aria-label={label} title={label}
    aria-haspopup="menu" aria-expanded="false" aria-controls="electrotutor-language-menu">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="m5 8 6 6M4 5h12M10 3v2M14 5c-1 6-5 9-10 11M14 21l4-10 4 10M15.6 17h4.8"
        fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <div class="language-switcher__menu" id="electrotutor-language-menu" role="menu" aria-label={label} hidden>
    {SUPPORTED_LANGUAGES.map(value => <a role="menuitemradio" tabindex="-1"
      aria-checked={value === language ? "true" : "false"}
      class:list={{ "language-switcher__option": true, "is-active": value === language }}
      href={localePath(value, alternatePath)} lang={value} data-language-option={value}
      data-language-link={value !== language ? "" : undefined}>
      <span>{labels[value]}</span>
      {value === language && <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" fill="none" stroke="currentColor" stroke-width="2"/></svg>}
    </a>)}
  </div>
</div>
<script>
  function initializeLanguageSwitcher() {
    const root = document.querySelector<HTMLElement>("[data-language-switcher]");
    if (!root || root.dataset.ready === "true") return;
    const trigger = root.querySelector<HTMLButtonElement>(".language-switcher__trigger");
    const menu = root.querySelector<HTMLElement>(".language-switcher__menu");
    const options = [...root.querySelectorAll<HTMLAnchorElement>("[data-language-option]")];
    if (!trigger || !menu) return;
    root.dataset.ready = "true";
    const controller = new AbortController();
    const listener = { signal: controller.signal };
    const close = (restore = false) => {
      menu.hidden = true; trigger.setAttribute("aria-expanded", "false");
      if (restore) trigger.focus();
    };
    const position = () => {
      menu.style.transform = "none";
      const bounds = menu.getBoundingClientRect();
      const edge = document.documentElement.clientWidth - 12;
      const shift = bounds.left < 12 ? 12 - bounds.left : bounds.right > edge ? edge - bounds.right : 0;
      menu.style.transform = `translateX(${shift}px)`;
    };
    const open = (index = options.findIndex(option => option.getAttribute("aria-checked") === "true")) => {
      menu.hidden = false; position(); trigger.setAttribute("aria-expanded", "true");
      options[Math.max(0, index)]?.focus();
    };
    trigger.addEventListener("click", () => menu.hidden ? open() : close(true), listener);
    trigger.addEventListener("keydown", event => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault(); open(event.key === "ArrowUp" ? options.length - 1 : 0);
      }
    }, listener);
    menu.addEventListener("keydown", event => {
      const index = options.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === "Escape") { event.preventDefault(); event.stopPropagation(); close(true); }
      else if (event.key === "Tab") close(true);
      else if (["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) {
        event.preventDefault(); const last = options.length - 1;
        const next = event.key === "Home" ? 0 : event.key === "End" ? last
          : event.key === "ArrowDown" ? (index + 1) % options.length : (index + last) % options.length;
        options[next]?.focus();
      } else if (event.key === " ") { event.preventDefault(); options[index]?.click(); }
    }, listener);
    const outside = (event: Event) => { if (event.target instanceof Node && !root.contains(event.target)) close(); };
    document.addEventListener("pointerdown", outside, listener);
    document.addEventListener("focusin", outside, listener);
    window.addEventListener("resize", () => { if (!menu.hidden) position(); }, listener);
    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal: controller.signal });
  }
  initializeLanguageSwitcher();
  document.addEventListener("astro:page-load", initializeLanguageSwitcher);
</script>

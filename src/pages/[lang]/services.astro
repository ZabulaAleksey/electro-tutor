---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Language } from "../../types";
import { getLocale } from "../../i18n";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}

const language = Astro.params.lang as Language;
const copy = getLocale(language);
const bookingUrl = import.meta.env.PUBLIC_CALCOM_URL;
---

<BaseLayout
  title={copy.services.title}
  description={copy.services.description}
  language={language}
  active="services"
  alternatePath="/services/"
>
  <section class="section services-page">
    <span class="eyebrow"><i></i>{copy.services.eyebrow}</span>
    <h1>{copy.services.heading}</h1>
    <p class="page-lead">{copy.services.lead}</p>
    <div class="service-grid">
      <article class="service-card featured">
        <span class="service-tag">{copy.services.online}</span>
        <h2>{copy.services.consultation}</h2>
        <p>{copy.services.consultationLead}</p>
        <ul>
          <li>{copy.services.freeTime}</li>
          <li>{copy.services.yourMaterials}</li>
          <li>{copy.services.onlineMeeting}</li>
        </ul>
        {bookingUrl
          ? <a class="button primary" href={bookingUrl} target="_blank" rel="noreferrer">{copy.services.chooseTime} →</a>
          : <span class="integration-note">{copy.services.calendarPending}</span>}
      </article>
      <article class="service-card">
        <span class="service-tag">{copy.services.digital}</span>
        <h2>{copy.services.materials}</h2>
        <p>{copy.services.materialsLead}</p>
        <span class="integration-note">{copy.services.catalogPending}</span>
      </article>
      <article class="service-card">
        <span class="service-tag">{copy.services.review}</span>
        <h2>{copy.services.solutionReview}</h2>
        <p>{copy.services.solutionReviewLead}</p>
        <span class="integration-note">{copy.services.requestsPending}</span>
      </article>
    </div>
    <section class="booking-section">
      <span class="section-kicker">{copy.services.schedule}</span>
      <h2>{copy.services.scheduleHeading}</h2>
      <p>{copy.services.scheduleLead}</p>
    </section>
  </section>
</BaseLayout>

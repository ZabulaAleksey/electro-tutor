---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedLessonManifest } from "../../content/published-lessons";
import { resolveTopicPublication } from "../../curriculum-publication";
import { curriculum } from "../../curriculum";
import type { Language } from "../../types";
import { formatMinutes, getLocale } from "../../i18n";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}

const language = Astro.params.lang as Language;
const copy = getLocale(language);
const homeSection = curriculum.find((section) => section.id === "dc");
if (!homeSection) {
  throw new Error('Homepage curriculum section "dc" is missing.');
}
const lessonManifest = await getPublishedLessonManifest();
const publishedTopics = homeSection.topics.map((topic) => ({
  topic,
  publication: resolveTopicPublication(lessonManifest, language, homeSection.id, topic),
}));
const primaryPublication = publishedTopics.find(({ publication }) => publication.available)?.publication;
---

<BaseLayout
  title={copy.home.title}
  description={copy.home.description}
  language={language}
  active="home"
  alternatePath="/"
>
  <section class="hero astro-home">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow"><i></i>{copy.home.eyebrow}</span>
        <h1>{copy.home.headingStart} —<br /><em>{copy.home.headingEnd}</em></h1>
        <p>{copy.home.lead}</p>
        <div class="hero-actions">
          <a
            class="button primary"
            href={primaryPublication?.available ? primaryPublication.href : `/${language}/topics/`}
          >
            {copy.home.primary} <span>→</span>
          </a>
          <a class="button ghost" href={`/${language}/topics/`}>{copy.home.secondary}</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="visual-card card-formula">
          <span>{copy.home.law}</span>
          <strong>∑ I<sub>k</sub> = 0</strong>
        </div>
        <svg viewBox="0 0 490 330">
          <g fill="none" stroke="currentColor" stroke-width="3">
            <path d="M50 95 H180 M310 95 H440 V245 H310 M180 245 H50 V95 M180 95 H310 M180 245 H310" />
            <path d="M245 95 V140 M245 190 V245" />
          </g>
          <g fill="none" stroke="currentColor" stroke-width="3">
            <rect x="95" y="80" width="70" height="30" rx="5" />
            <rect x="325" y="80" width="70" height="30" rx="5" />
            <rect x="230" y="135" width="30" height="60" rx="5" />
            <circle cx="50" cy="170" r="27" />
            <circle cx="440" cy="170" r="27" />
          </g>
        </svg>
      </div>
    </div>
    <div class="feature-strip">
      <span>RU / UA</span>
      <span>3 {copy.home.levels}</span>
      <span>LaTeX</span>
      <span>{copy.home.visualSchemes}</span>
    </div>
  </section>

  <section class="section topic-preview">
    <div class="section-heading">
      <div><span class="section-kicker">01 — DC</span><h2>{copy.home.section}</h2></div>
      <p>{copy.home.sectionLead}</p>
    </div>
    <div class="topic-grid">
      {publishedTopics.map(({ topic, publication }) => (
        <article class={`topic-card ${topic.accent}`}>
          <div class="topic-card-top"><span>{topic.index}</span><small>{formatMinutes(language, topic.duration)}</small></div>
          <h3>{topic.title[language]}</h3>
          <p>{topic.description[language]}</p>
          {publication.available
            ? <a href={publication.href}>{copy.actions.startLearning} →</a>
            : <span class="soon-label">{copy.actions.soon}</span>}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

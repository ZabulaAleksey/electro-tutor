---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Language } from "../../types";
import { getLocale } from "../../i18n";
export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const copy = getLocale(language);
---
<BaseLayout title={copy.contacts.title} description={copy.contacts.description} language={language} active="contacts" alternatePath="/contacts/">
  <section class="section info-page">
    <span class="eyebrow"><i></i>{copy.contacts.eyebrow}</span>
    <h1>{copy.contacts.heading}</h1>
    <p>{copy.contacts.lead}</p>
    <div class="info-placeholder">
      <strong>{copy.contacts.placeholder}</strong>
      <span>E-mail · Telegram · LinkedIn</span>
    </div>
  </section>
</BaseLayout>

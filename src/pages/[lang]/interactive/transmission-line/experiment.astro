---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import LineExperimentLab from "../../../../components/LineExperimentLab";
import { getLocale } from "../../../../i18n";
import { localePath } from "../../../../site-path";
import type { Language } from "../../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const ru = language === "ru";
const title = ru ? "Переходные процессы в длинной линии" : "Перехідні процеси в довгій лінії";
const description = ru
  ? "Соберите схему линии и исследуйте переходные волны по координате и времени."
  : "Зберіть схему лінії та дослідіть перехідні хвилі за координатою й часом.";
---
<BaseLayout title={`${title} · ${getLocale(language).brand.display}`} {description} {language}
  active="interactive" alternatePath="/interactive/transmission-line/experiment/">
  <section class="line-a-page">
    <a href={localePath(language, "/interactive/")}>{ru ? "← Лаборатории" : "← Лабораторії"}</a>
    <h1>{title}</h1>
    <LineExperimentLab client:load {language} />
  </section>
</BaseLayout>

<style>
  .line-a-page { width: min(100% - 2rem, 82rem); margin: 1rem auto 3rem; }
  .line-a-page h1 { margin: .55rem 0 1.1rem; font-size: clamp(1.45rem, 4vw, 2.55rem); }
  .line-a-page > a { display: inline-flex; align-items: center; min-height: 44px; }
  .line-a-page :global(.line-a-archive) { display: flex; gap: .55rem; flex-wrap: wrap; margin-block: 1rem; }
  .line-a-page :global(.line-a-archive button) { min-height: 44px; padding: .5rem .8rem; cursor: pointer; }
  .line-a-page :global([data-line-a-source-assumption]) { max-width: 70ch; }
  .line-a-page :global([data-line-a-model-error]),
  .line-a-page :global([data-line-a-action-error]) { padding: .65rem; border: 1px solid currentColor; color: var(--c-error, #9b2226); }
</style>

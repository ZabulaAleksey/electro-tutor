---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localePath } from "../../site-path";
import type { Language } from "../../types";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}

const language = Astro.params.lang as Language;
const russian = language === "ru";
const configuredUrl = import.meta.env.PUBLIC_MATHMORPH_URL;
let mathMorphUrl: string | undefined;
try {
  const url = new URL(configuredUrl || "");
  if (url.protocol === "https:" && !url.username && !url.password) mathMorphUrl = url.href;
} catch {}
---

<BaseLayout
  title={russian ? "Дополнительные сервисы — ElectroTutor" : "Додаткові сервіси — ElectroTutor"}
  description={russian ? "Подключённые инженерные сервисы ElectroTutor." : "Підключені інженерні сервіси ElectroTutor."}
  language={language}
  active="my-services"
  alternatePath="/my-services/"
>
  <section class="section catalog-page my-services-page">
    <h1>{russian ? "Дополнительные сервисы" : "Додаткові сервіси"}</h1>
    <p class="catalog-page-lead">{russian ? "Установить приложение и открыть подключённые инструменты." : "Установити застосунок і відкрити підключені інструменти."}</p>
      <div class="catalog-card-grid service-card-grid">
      <article class="tool-card service-tool-card app-install-card" id="install">
        <span class="section-kicker">ELECTROTUTOR</span>
        <h2>{russian ? "Приложение" : "Застосунок"}</h2>
        <p>{russian ? "Добавьте учебник на главный экран для быстрого доступа." : "Додайте підручник на головний екран для швидкого доступу."}</p>
        <button class="tool-card-action app-install-link" id="app-install" type="button">{russian ? "Установить приложение" : "Встановити застосунок"} →</button>
      </article>
      <article class="tool-card service-tool-card">
        <span class="section-kicker" id="mathmorph">MATHMORPH</span>
        <h2>MathMorph</h2>
        <p>{mathMorphUrl
          ? (russian ? "Преобразование математических документов." : "Перетворення математичних документів.")
          : (russian ? "Сервис пока не подключён." : "Сервіс поки не підключений.")}</p>
        {mathMorphUrl
          ? <a class="tool-card-action" href={mathMorphUrl} target="_blank" rel="noreferrer">{russian ? "Открыть сервис" : "Відкрити сервіс"} →</a>
          : <span class="integration-note">{russian ? "Ссылка появится после настройки владельцем." : "Посилання з’явиться після налаштування власником."}</span>}
      </article>
      <article class="tool-card service-tool-card">
        <span class="section-kicker">JITSI</span>
        <h2>{russian ? "Гостевая видеокомната" : "Гостьова відеокімната"}</h2>
        <p>{russian ? "Внешний сервис meet.jit.si: первый участник должен войти как модератор на стороне Jitsi. Создание ссылки ещё не означает, что связь установлена." : "Зовнішній сервіс meet.jit.si: перший учасник має увійти як модератор на боці Jitsi. Створення посилання ще не означає, що зв’язок установлено."}</p>
        <a class="tool-card-action" href={localePath(language,"/classroom/")}>{russian ? "Открыть гостевую комнату" : "Відкрити гостьову кімнату"} →</a>
      </article>
      <article class="tool-card service-tool-card" aria-label={russian ? "Контролируемое видеозанятие не реализовано" : "Кероване відеозаняття не реалізовано"}>
        <span class="section-kicker">VIDEO</span>
        <h2>{russian ? "Контролируемое видеозанятие" : "Кероване відеозаняття"}</h2>
        <p>{russian ? "Не реализовано: защищённая учебная сессия пока не содержит медиасвязи. Гостевая Jitsi-комната — отдельный внешний сервис." : "Не реалізовано: захищена навчальна сесія поки не містить медіазв’язку. Гостьова Jitsi-кімната — окремий зовнішній сервіс."}</p>
        <span class="tool-card-disabled">{russian ? "Недоступно" : "Недоступно"}</span>
      </article>

      </div>
  </section>
</BaseLayout>

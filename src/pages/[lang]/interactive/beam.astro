---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BeamLab from "../../../beam/BeamLab";
import { localePath } from "../../../site-path";
import type { Language } from "../../../types";
import { beamCopy } from "../../../beam/copy";
export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const copy = beamCopy[language];
---
<BaseLayout title={copy.title} description={copy.lead} language={language} active="interactive" alternatePath="/interactive/beam/">
  <section class="beam-page"><a href={localePath(language, "/interactive/")}>← {language === "ru" ? "Лаборатория" : "Лабораторія"}</a><h1>{copy.title}</h1><p>{copy.lead}</p><BeamLab client:load language={language} /></section>
</BaseLayout>

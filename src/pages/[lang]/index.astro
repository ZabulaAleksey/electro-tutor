---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EngineeringShowcase from "../../showcase/EngineeringShowcase";
import { getPublishedLessonManifest } from "../../content/published-lessons";
import { resolveTopicPublication } from "../../curriculum-publication";
import { curriculum } from "../../curriculum";
import type { Language } from "../../types";
import { getLocale } from "../../i18n";
import { localePath } from "../../site-path";
import { publicSurface } from "../../public-surface";

export function getStaticPaths() {
  return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }];
}

const language = Astro.params.lang as Language;
const copy = getLocale(language);
const homeSection = curriculum.find((section) => section.id === "dc");
if (!homeSection) {
  throw new Error('Homepage curriculum section "dc" is missing.');
}
const lessonManifest = await getPublishedLessonManifest();
const publishedTopics = homeSection.topics.map((topic) => ({
  topic,
  publication: resolveTopicPublication(lessonManifest, language, homeSection.id, topic),
}));
const primaryPublication = publishedTopics.find(({ publication }) => publication.available)?.publication;
---

<BaseLayout
  title={copy.home.title}
  description={copy.home.description}
  language={language}
  active="home"
  alternatePath="/"
>
  <EngineeringShowcase client:load language={language}
    lessonHref={primaryPublication?.available ? primaryPublication.href : localePath(language, "/topics/")}
    lessonLabel={copy.home.primary} />

  {publicSurface.showProgress && <section class="section" aria-labelledby="learning-summary-title">
    <div class="learning-summary">
      <h2 id="learning-summary-title">{copy.learning.summaryDevice}</h2>
      <div data-learning-summary></div>
    </div>
  </section>}

</BaseLayout>

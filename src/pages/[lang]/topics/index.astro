---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import TextbookCatalogue from "../../../components/TextbookCatalogue.astro";
import { getContentCatalogue } from "../../../learning/get-content-catalogue";
import { stageCopy } from "../../../learning/navigation-copy";
import { getLocale } from "../../../i18n";

export function getStaticPaths() {
  return [{ params: { lang: "ru" as const } }, { params: { lang: "uk" as const } }];
}

const { lang: language } = Astro.params;
const catalogue = await getContentCatalogue(language);
const title = stageCopy[language].textbook;
---
<BaseLayout title={`${title} — ElectroTutor`} description={getLocale(language).topics.description} {language} active="topics" alternatePath="/topics/">
  <TextbookCatalogue {language} {catalogue} includeOtherResources pageHeading />
</BaseLayout>

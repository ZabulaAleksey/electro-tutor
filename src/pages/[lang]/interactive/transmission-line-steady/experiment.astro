---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SteadyExperimentLab from "../../../../components/SteadyExperimentLab";
import { getLocale } from "../../../../i18n";
import { localePath } from "../../../../site-path";
import type { Language } from "../../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const ru = language === "ru";
const title = ru ? "Длинная линия в синусоидальном режиме" : "Довга лінія в синусоїдному режимі";
const description = ru
  ? "Соберите схему длинной линии и исследуйте напряжение, ток, импеданс и мощность в установившемся режиме."
  : "Зберіть схему довгої лінії та дослідіть напругу, струм, імпеданс і потужність в усталеному режимі.";
---
<BaseLayout title={title + " · " + getLocale(language).brand.display} {description} {language}
  active="interactive" alternatePath="/interactive/transmission-line-steady/experiment/">
  <section class="line-b-page">
    <a href={localePath(language, "/interactive/")}>{ru ? "← Лаборатории" : "← Лабораторії"}</a>
    <h1>{title}</h1>
    <SteadyExperimentLab client:load {language} />
  </section>
</BaseLayout>

<style>
  .line-b-page { width: min(100% - 2rem, 82rem); margin: 1rem auto 3rem; }
  .line-b-page h1 { margin: .55rem 0 1.1rem; font-size: clamp(1.45rem, 4vw, 2.55rem); }
  .line-b-page > a { display: inline-flex; align-items: center; min-height: 44px; }
</style>

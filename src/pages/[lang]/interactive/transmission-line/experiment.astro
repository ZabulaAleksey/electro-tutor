---
import LaboratoryPage from "../../../../components/LaboratoryPage.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import LineExperimentLab from "../../../../components/LineExperimentLab";
import { getLocale } from "../../../../i18n";
import type { Language } from "../../../../types";

export function getStaticPaths() { return [{ params: { lang: "ru" } }, { params: { lang: "uk" } }]; }
const language = Astro.params.lang as Language;
const ru = language === "ru";
const title = ru ? "Переходные процессы в длинной линии" : "Перехідні процеси в довгій лінії";
const description = ru
  ? "Соберите схему линии и исследуйте переходные волны по координате и времени."
  : "Зберіть схему лінії та дослідіть перехідні хвилі за координатою й часом.";
---
<BaseLayout title={`${title} · ${getLocale(language).brand.display}`} {description} {language}
  active="interactive" alternatePath="/interactive/transmission-line/experiment/">
  <LaboratoryPage {language} title={title} description={description}>
    <LineExperimentLab client:load {language} />
  </LaboratoryPage>
</BaseLayout>
